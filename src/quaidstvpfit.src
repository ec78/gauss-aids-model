#include quaids.sdf

/*
** quaidstvpfit.src
**
** TVP-AIDS initiative, Stage 6: the consolidated public entry point --
** quaidsTVPFit()/printQuaidsTVP()/quaidsTVPControlCreate() -- publishing
** Stages 1-5's already-tested private machinery as real, documented,
** supported public API. Adds NO new estimation math: quaidsTVPFit() is
** pure orchestration over already-validated pieces --
**
**   _quaidsTVPStoneIndex() + _quaidsTVPBuildZ()   (Stage 1, quaidstvp.src)
**   _quaidsTVPMLEFit()                            (Stage 3, quaidstvpmle.src
**                                                    -- itself runs Stage 2's
**                                                    _quaidsTVPKalmanFit()
**                                                    internally via sslib's
**                                                    ssFitTVP())
**   _quaidsTVPSmoothFit()                         (Stage 4, quaidstvpsmooth.src,
**                                                    only if tvpCtl.smooth)
**   quaidsTVPStateToFullB()                       (Stage 5, quaidstvp.src,
**                                                    at the final period)
**
** -- so this file's own header carries no new design decisions beyond
** "publish what Stages 1-5 already built and validated." See each of
** those files' own headers for the actual estimation design rationale
** (Stone index, hard-constrained symmetry, Q-only/diagonal-only MLE
** scope, H staying caller-fixed).
**
** Public surface stays deliberately MINIMAL (a repo-owner decision made
** explicitly before this file was written): only quaidsTVPFit()/
** printQuaidsTVP()/quaidsTVPControlCreate() are new here, plus
** quaidsTVPStateToFullB()/quaidsTVPElasFit() (promoted in place, dropping
** their leading underscore, in quaidstvp.src/quaidstvpelas.src
** respectively -- see those files' own updated headers). Every Stage 2-4
** building block (_quaidsTVPBuildModel/_quaidsTVPKalmanFit/
** _quaidsTVPMLEFit/_quaidsTVPQUpdate/_quaidsTVPSmoothFit/
** _quaidsTVPReplicateConstant) stays private, called only internally by
** quaidsTVPFit() -- matches this library's existing convention of one
** clean Fit()-style entry point per feature (quaidsFit(),
** quaidsWorkflowFit()) rather than exposing every intermediate stage
** separately.
**
** H and q0 stay REQUIRED, caller-supplied arguments to quaidsTVPFit()
** itself (not quaidsTVPControl fields, and no "smart default" heuristic
** invented here) -- matches Stage 2/3's own already-tested,
** repo-owner-approved scope (H fixed, never estimated; Q's own starting
** value is the caller's responsibility). Existing lower-level shape
** guards (already in _quaidsTVPMLEFit/_quaidsTVPBuildModel) are relied on
** as-is, not duplicated here.
**
** Required #include chain (this file only #include's quaids.sdf itself,
** matching every other .src file's own convention in this codebase -- no
** sibling .src #includes anywhere), same documented-dependency pattern
** quaidstvpelas.src's own header already uses:
**
**   library cmlmt, tsmt, sslib, quaids;
**   #include quaids.sdf
**   #include quaidstvp.src
**   #include quaidstvpkalman.src
**   #include quaidstvpmle.src
**   #include quaidstvpsmooth.src
**   #include quaidstvpelas.src
**   #include quaidstvpfit.src
**
** Real, documented, supported public API as of Stage 6, but still NOT in
** package.json's src array -- same "optional adapter" reasoning that
** already keeps quaidscurvature.src/pubtable_quaids.src out (a hard
** sslib dependency on every `library quaids;` user would be wrong even
** though this is now intentional public API, not WIP -- see CLAUDE.md's
** "Optional modules" section). In verify_package_manifest.ps1's
** intentionallyUnlisted allowlist alongside the other five TVP-AIDS
** files. sslib itself stays pinned via the repo-root sslib.pin.json /
** scripts/sync_sslib.ps1 / scripts/verify_sslib_pin.ps1 mechanism (new in
** this stage) rather than package.json's own deps array, which stays
** reserved for "hard requirement to even install/compile the core
** package."
*/


/*
** quaidsTVPControlCreate
**
** Purpose: default quaidsTVPControl -- mirrors quaidsControlCreate()'s
**          own minimalism.
**
** Format:     tvpCtl = quaidsTVPControlCreate();
**
** Output:     tvpCtl -- struct quaidsTVPControl: smooth = 1 (also run the
**                       Stage 4 RTS smoother), othnam = 0 (auto W1..Wn
**                       good names), maxIters = 1e5 and maxTime = 1e8
**                       minutes (CMLMT's own defaults, so a fit is
**                       numerically identical to one made before these
**                       two fields existed -- set finite values to bound
**                       the Q MLE's run time). Both caps apply PER CMLMT
**                       PASS; with sslib v2.1.2 there is one pass, so
**                       they bound the whole Q MLE (see quaids.sdf).
*/
proc (struct quaidsTVPControl) = quaidsTVPControlCreate();
    struct quaidsTVPControl tvpCtl;

    tvpCtl.smooth = 1;
    tvpCtl.othnam = 0;
    tvpCtl.maxIters = 1e5;
    tvpCtl.maxTime = 1e8;

    retp(tvpCtl);
endp;


/*
** _quaidsTVPResolveCaps
**
** Purpose: validates quaidsTVPControl's optimizer caps and resolves an
**          empty field ({} -- a struct declared without
**          quaidsTVPControlCreate()) to its CMLMT default. Fails loudly
**          on anything that is not a usable finite cap, before any
**          estimation work starts.
**
** Format:     { maxIters, maxTime } = _quaidsTVPResolveCaps(tvpCtl);
*/
proc (2) = _quaidsTVPResolveCaps(struct quaidsTVPControl tvpCtl);
    local mi, mt;

    mi = tvpCtl.maxIters;
    mt = tvpCtl.maxTime;
    if rows(mi) == 0;
        mi = 1e5;
    endif;
    if rows(mt) == 0;
        mt = 1e8;
    endif;

    if type(mi) /= 6 or rows(mi) /= 1 or cols(mi) /= 1;
        errorlog "quaidsTVPFit: tvpCtl.maxIters must be a scalar.";
        end;
    endif;
    if scalmiss(mi) or mi /= mi or abs(mi) == __INFp or mi < 1 or mi /= round(mi);
        errorlog "quaidsTVPFit: tvpCtl.maxIters must be a finite positive integer (CMLMT iteration cap).";
        end;
    endif;
    if type(mt) /= 6 or rows(mt) /= 1 or cols(mt) /= 1;
        errorlog "quaidsTVPFit: tvpCtl.maxTime must be a scalar.";
        end;
    endif;
    if scalmiss(mt) or mt /= mt or abs(mt) == __INFp or mt <= 0;
        errorlog "quaidsTVPFit: tvpCtl.maxTime must be a finite positive number of minutes (CMLMT time cap).";
        end;
    endif;

    retp(mi, mt);
endp;


/*
** quaidsTVPFit
**
** Purpose: genuine time-varying-parameter (Kalman-filter-based) AIDS
**          estimation -- one call from raw data to a fitted, optionally
**          smoothed, state path plus a final-period coefficient snapshot.
**          See this file's own header for exactly which already-validated
**          Stage 1-5 pieces this orchestrates, in order.
**
** Format:     tvOut = quaidsTVPFit(w, prices, totexp, H, q0, tvpCtl);
**
** Input:      w      -- TxN budget shares.
**             prices -- TxN ABSOLUTE log prices.
**             totexp -- Tx1 log total expenditure. Unlike quaidsFit(),
**                       this initiative's own reduced state-space design
**                       (Stage 1) has no IV/endogeneity treatment --
**                       totexp is used directly, not first-stage-purged.
**             H      -- n1 x n1 FIXED observation covariance (n1 = N-1,
**                       homogeneity always imposed) -- caller-supplied,
**                       never estimated (Stage 3's own repo-owner-approved
**                       scope; see quaidstvpmle.src's header for why joint
**                       Q/H MLE is not attempted). A simple starting
**                       choice: a diagonal matrix from quaidsFit()'s own
**                       homogSse/nobs residual variances on the same
**                       data.
**             q0     -- k_states x 1 STARTING Q diagonal, natural
**                       (positive variance) units (k_states = 2*n1 +
**                       n1*(n1+1)/2 -- see quaidstvp.src's own header for
**                       the state vector's layout). Every element must be
**                       strictly positive.
**             tvpCtl -- struct quaidsTVPControl (quaidsTVPControlCreate()
**                       for defaults). tvpCtl.maxIters/maxTime cap the Q
**                       MLE (CMLMT iterations / minutes) PER CMLMT PASS.
**                       With sslib v2.1.2, ssFitTVP() runs one CMLMT pass
**                       (its covariance is a delta-method conversion, not
**                       a second CMLMT run), so the caps bound the whole
**                       MLE, plus up to one iteration of overrun. Invalid
**                       values fail loudly before any estimation work. An
**                       exhausted cap returns normally with
**                       tvOut.mleRetcode /= 0 (CMLMT's own code: 2
**                       iterations, 11 time) -- check it, as
**                       printQuaidsTVP() does.
**
** Output:     tvOut -- struct quaidsTVPOut (see quaids.sdf): fitted Q,
**                      MLE convergence code, filtered state path (+
**                      covariance), smoothed state path (+ covariance, if
**                      tvpCtl.smooth -- else zeros), and bFinal (the full
**                      n-good coefficient snapshot at the final period's
**                      smoothed-if-available-else-filtered state, via
**                      quaidsTVPStateToFullB() -- point values only, no
**                      standard errors).
**
** Requires:   `library cmlmt, tsmt, sslib;` (or equivalent) and the
**             #include chain documented in this file's own header.
*/
proc (struct quaidsTVPOut) = quaidsTVPFit(w, prices, totexp, H, q0, struct quaidsTVPControl tvpCtl);
    local n, n1, nobs, k_states, wnam, pricesRel, lx, Zarr, sOut, a_TS, p_TS, finalState,
        maxIters, maxTime;
    struct quaidsTVPOut tvOut;

    { maxIters, maxTime } = _quaidsTVPResolveCaps(tvpCtl);

    n = cols(prices);
    n1 = n - 1;
    nobs = rows(w);
    k_states = 2*n1 + n1*(n1+1)/2;

    if tvpCtl.othnam == 0;
        wnam = 0$+"W"$+ftocv(seqa(1, 1, n), __vpad*(floor(log(n)+1), 0));
    else;
        wnam = tvpCtl.othnam[1:n];
    endif;

    pricesRel = prices[., 1:n1] - prices[., n];
    lx = _quaidsTVPStoneIndex(w, prices, totexp, n);
    Zarr = _quaidsTVPBuildZ(pricesRel, lx, n1);

    sOut = _quaidsTVPMLEFit(Zarr, H, w[., 1:n1], q0, n1, maxIters, maxTime);

    tvOut.n = n;
    tvOut.n1 = n1;
    tvOut.nobs = nobs;
    tvOut.k_states = k_states;
    tvOut.wnam = wnam;
    tvOut.H = H;
    tvOut.q0 = q0;
    tvOut.Qfit = sOut.final_params;
    tvOut.mleRetcode = sOut.mleResults.retcode;
    tvOut.filteredState = sOut.kfResults.filtered_state;
    tvOut.filteredStateCov = sOut.kfResults.filtered_state_cov;
    tvOut.smoothed = tvpCtl.smooth;

    if tvpCtl.smooth;
        { a_TS, p_TS } = _quaidsTVPSmoothFit(sOut.tvpFinal, sOut.kfResults);
        tvOut.smoothedState = a_TS;
        tvOut.smoothedStateCov = p_TS;
        finalState = a_TS[., nobs];
    else;
        tvOut.smoothedState = 0;
        /* smoothedStateCov is `array`-typed (see quaids.sdf) -- a bare
           scalar 0 assignment to an array-typed struct field is a real,
           confirmed GAUSS failure mode in this exact codebase (see
           quaidstvpkalman.src's own _quaidsTVPReplicateConstant header:
           "Illegal assignment - type mismatch"), so the "not smoothed"
           sentinel must itself be a genuine (if minimal) array, not a
           bare 0. */
        tvOut.smoothedStateCov = arrayinit(1|1|1, 0);
        finalState = tvOut.filteredState[., nobs];
    endif;

    tvOut.bFinal = quaidsTVPStateToFullB(finalState, n1);

    retp(tvOut);
endp;


/*******************************************************************************
**
** PRINTQUAIDSTVP
**
** Purpose: print the report captured in a quaidsTVPOut struct -- MLE
**          convergence, the fitted Q diagonal grouped by the state
**          vector's own alpha/gamma/beta blocks (see quaidstvp.src's own
**          header for that layout), and the final-period coefficient
**          snapshot in printQuaidsTrend()'s existing table layout (point
**          values only here -- no delta-method SEs are available for a
**          TVP-AIDS fit yet, see quaidstvpelas.src's own Remarks).
**
** Format:     call printQuaidsTVP(tvOut);
**
*******************************************************************************/

proc 0 = printQuaidsTVP(struct quaidsTVPOut tvOut);

    local n1, ngamma, qAlpha, qGamma, qBeta, rlab, i;

    n1 = tvOut.n1;
    ngamma = n1*(n1+1)/2;

    print "TVP-AIDS FIT (genuine time-varying-parameter estimation via a Kalman filter)";
    print "n = " $+ ftocv(tvOut.n, 1, 0) $+ "   nobs = " $+ ftocv(tvOut.nobs, 1, 0)
        $+ "   k_states = " $+ ftocv(tvOut.k_states, 1, 0);
    print;

    if tvOut.mleRetcode == 0;
        print "MLE (Q, against a fixed H): CONVERGED";
    else;
        print "MLE (Q, against a fixed H): DID NOT CONVERGE (retcode = " $+ ftocv(tvOut.mleRetcode, 1, 0) $+ ") -- treat results with caution.";
    endif;
    print;

    print "FITTED STATE INNOVATION VARIANCES (Q diagonal, by state block):";
    qAlpha = tvOut.Qfit[1:n1];
    qGamma = tvOut.Qfit[n1+1:n1+ngamma];
    qBeta = tvOut.Qfit[n1+ngamma+1:tvOut.k_states];
    /* Label on its OWN print line, values via a separate print$ --
       confirmed via an isolated repro that concatenating a label string
       with a multi-element ftocv() result via $+ BROADCASTS the label
       across every element (each element gets its own copy of the label,
       garbling the row into repeated "label: value  label: value  ..."
       text) rather than producing one joined string -- this codebase's
       own existing per-row printers never ftocv() more than a single
       ROW at once for exactly this reason. A `~`-horzcat label instead of
       `$+` avoids the broadcast but hits the OTHER already-documented
       CLAUDE.md gotcha (legacy character-matrix cells truncate to 8
       characters), which is exactly why every existing multi-row printer
       already keeps a label and its row of values on separate print
       calls, not smashed into one line via either operator. */
    print "  alpha block:";
    print$ ftocv(qAlpha', 0, 6);
    print "  gamma block:";
    print$ ftocv(qGamma', 0, 6);
    print "  beta  block:";
    print$ ftocv(qBeta', 0, 6);
    print;

    if tvOut.smoothed;
        print "FINAL-PERIOD COEFFICIENTS (smoothed state -- point estimates only, no SEs):";
    else;
        print "FINAL-PERIOD COEFFICIENTS (filtered state -- tvpCtl.smooth was 0 -- point estimates only, no SEs):";
    endif;
    print$ "row"~tvOut.wnam';
    print "------------------------------------------------------------------------";
    /* Row-by-row print$, matching printQuaidsCurvature/printQuaidsZero's
       own pattern -- every existing printer in this codebase applies
       ftocv() to one row at a time, never a full multi-row matrix in one
       call, so this follows that same proven convention rather than
       risking an unproven whole-matrix ftocv() call. */
    rlab = "alpha"|(0$+"gamma"$+ftocv(seqa(1, 1, tvOut.n), __vpad*(floor(log(tvOut.n)+1), 0)))|"beta";
    i = 1;
    do while i <= rows(tvOut.bFinal);
        print$ rlab[i]~ftocv(tvOut.bFinal[i, .], 0, 4);
        i = i + 1;
    endo;
    print;

endp;


/* ========================================================================== */
/* Public TVP diagnostics (v0.5.0 candidate).                                  */
/* ========================================================================== */

/* True only for a nonempty numeric matrix containing finite values. */
proc (1) = _quaidsTVPDiagFinite(x);
    if type(x) /= 6 or rows(x) == 0 or cols(x) == 0;
        retp(0);
    endif;
    if ismiss(x);
        retp(0);
    endif;
    if sumc(vec(x .== x)) /= rows(x)*cols(x);
        retp(0);
    endif;
    if maxc(abs(vec(x))) == __INFp;
        retp(0);
    endif;
    retp(1);
endp;


/* Pure predicate plus fail-loud resolver for the shared scale marker. */
proc (1) = _quaidsTVPDiagScaleRatioValid(scaleRatio);
    if type(scaleRatio) /= 6 or rows(scaleRatio) /= 1 or cols(scaleRatio) /= 1;
        retp(0);
    endif;
    if scalmiss(scaleRatio) or scaleRatio /= scaleRatio or
        abs(scaleRatio) == __INFp or scaleRatio <= 0 or scaleRatio >= 1;
        retp(0);
    endif;
    retp(1);
endp;


proc (1) = _quaidsTVPDiagResolveScaleRatio(scaleRatio, caller);
    if not _quaidsTVPDiagScaleRatioValid(scaleRatio);
        errorlog caller $+ ": scaleRatio must be a finite numeric scalar strictly between 0 and 1.";
        end;
    endif;
    retp(scaleRatio);
endp;


/* Shape/finiteness/strict-positivity predicate used before every summary. */
proc (1) = _quaidsTVPDiagQValid(q, expectedRows);
    if type(q) /= 6 or rows(q) /= expectedRows or cols(q) /= 1 or expectedRows < 1;
        retp(0);
    endif;
    if not _quaidsTVPDiagFinite(q);
        retp(0);
    endif;
    retp(minc(q) > 0);
endp;


/* Normalize a candidate Q to a safe, conformable all-missing fallback. */
proc (2) = _quaidsTVPDiagNormalizeQ(q, expectedRows);
    local valid, normalized;
    normalized = miss(zeros(expectedRows, 1), 0);
    valid = _quaidsTVPDiagQValid(q, expectedRows);
    if valid;
        normalized = q;
    endif;
    retp(valid, normalized);
endp;


/* Strict start-relative collapse count and flag for one already-valid arm. */
proc (2) = _quaidsTVPDiagScaleCaution(qFit, qStart, scaleRatio);
    local nScaleCollapse, scaleCaution;
    nScaleCollapse = sumc(qFit .< scaleRatio*qStart);
    scaleCaution = nScaleCollapse > 0;
    retp(scaleCaution, nScaleCollapse);
endp;


/* A valid common-scale total log likelihood is one finite scalar. */
proc (1) = _quaidsTVPDiagLLValid(ll);
    if type(ll) /= 6 or rows(ll) /= 1 or cols(ll) /= 1;
        retp(0);
    endif;
    retp(_quaidsTVPDiagFinite(ll));
endp;


/* Invalid LL values are never retained in a public result. */
proc (2) = _quaidsTVPDiagNormalizeLL(ll);
    local valid, normalized;
    valid = _quaidsTVPDiagLLValid(ll);
    if valid;
        normalized = ll;
    else;
        normalized = miss(0, 0);
    endif;
    retp(valid, normalized);
endp;


/* Shared numeric status label. */
proc (1) = _quaidsTVPDiagStatusLabel(status, successLabel);
    if status == 0;
        retp(successLabel);
    elseif status == 1;
        retp("FIT-FAILED");
    elseif status == 2;
        retp("INVALID-Q");
    elseif status == 3;
        retp("INVALID-LOGLIKELIHOOD");
    elseif status == 4;
        retp("START-SENSITIVE");
    elseif status == 5;
        retp("SCALE-CAUTION");
    endif;
    retp("UNKNOWN");
endp;


/* Pure multi-start precedence seam used by focused tests. */
proc (1) = _quaidsTVPDiagMultiStatus(
    retcodes, qValid, llValid, anyScaleCaution, maxLLGap, tolerance);

    if sumc(retcodes .== 0) /= rows(retcodes);
        retp(1);
    elseif sumc(qValid .== 1) /= rows(qValid);
        retp(2);
    elseif sumc(llValid .== 1) /= rows(llValid);
        retp(3);
    elseif maxLLGap > tolerance;
        retp(4);
    elseif anyScaleCaution == 1;
        retp(5);
    endif;
    retp(0);
endp;


/* Pure fixed-grid LL comparison seam; callers pass three valid scalars. */
proc (5) = _quaidsTVPDiagCompareLL(retcodes, loglikelihoods, nobs);
    local bestStartIndex, bestLL, maxLLGap, tolerance, startStable;

    tolerance = 1e-6*nobs;
    bestStartIndex = maxindc(loglikelihoods);
    bestLL = loglikelihoods[bestStartIndex];
    maxLLGap = maxc(bestLL - loglikelihoods);
    startStable = sumc(retcodes .== 0) == rows(retcodes) and
        maxLLGap <= tolerance;

    retp(startStable, bestStartIndex, bestLL, maxLLGap, tolerance);
endp;


/*
** quaidsTVPDiagnostics
**
** Summarize an existing fit without refitting or invoking a Kalman filter.
** A scale caution is start-relative and is not a boundary, identification
** or inference claim.
*/
proc (struct quaidsTVPDiagOut) = quaidsTVPDiagnostics(struct quaidsTVPOut tvOut, scaleRatio=1e-3);

    local expectedRows, ratios;
    struct quaidsTVPDiagOut dOut;

    scaleRatio = _quaidsTVPDiagResolveScaleRatio(
        scaleRatio, "quaidsTVPDiagnostics");

    dOut.mleRetcode = tvOut.mleRetcode;
    dOut.fitOk = tvOut.mleRetcode == 0;
    dOut.scaleRatio = scaleRatio;
    expectedRows = rows(tvOut.q0);
    dOut.qValid = _quaidsTVPDiagQValid(tvOut.q0, expectedRows) and
        _quaidsTVPDiagQValid(tvOut.Qfit, expectedRows);

    if dOut.qValid;
        ratios = tvOut.Qfit ./ tvOut.q0;
        dOut.nScaleCollapse = sumc(ratios .< scaleRatio);
        dOut.scaleCaution = dOut.nScaleCollapse > 0;
        dOut.minQOverQ0 = minc(ratios);
        dOut.maxQOverQ0 = maxc(ratios);
    else;
        dOut.scaleCaution = miss(0, 0);
        dOut.nScaleCollapse = miss(0, 0);
        dOut.minQOverQ0 = miss(0, 0);
        dOut.maxQOverQ0 = miss(0, 0);
    endif;

    if not dOut.fitOk;
        dOut.status = 1;
    elseif not dOut.qValid;
        dOut.status = 2;
    elseif dOut.scaleCaution;
        dOut.status = 5;
    else;
        dOut.status = 0;
    endif;
    dOut.statusLabel = _quaidsTVPDiagStatusLabel(dOut.status, "OK");

    retp(dOut);
endp;


/* Re-evaluate total LL through the production fixed-Q diffuse filter. */
proc (1) = _quaidsTVPDiagTotalLL(Zarr, q, H, y, n1);
    struct tvpModel tvpm;
    struct kalmanResult rslt;

    tvpm = _quaidsTVPBuildModel(
        Zarr, diagrv(eye(rows(q)), q), H, n1);
    rslt = _quaidsTVPKalmanFit(tvpm, y', 1);
    retp(sumc(rslt.loglikelihood));
endp;


/*
** quaidsTVPMultiStartDiagnostics
**
** Run three complete Q-MLE fits from the fixed 0.1x/1x/10x grid and compare
** their common-scale fixed-Q filter likelihoods. Observed agreement is not a
** global-optimum claim. Only maxIters/maxTime from tvpCtl are used.
*/
proc (struct quaidsTVPMultiStartOut) = quaidsTVPMultiStartDiagnostics(w, prices, totexp, H, q0, struct quaidsTVPControl tvpCtl, scaleRatio=1e-3);

    local maxIters, maxTime, n, n1, nobs, k_states, pricesRel, lx, Zarr,
        multipliers, qStarts, retcodes, fitOk, qValid, llValid,
        scaleCaution, loglikelihoods, qfits, nScaleCollapse,
        i, qFitRaw, qFit, qIsValid, armScaleCaution, armScaleCollapse,
        llRaw, ll, llIsValid,
        nValidQ, anyCaution, bestStartIndex,
        bestLL, maxLLGap, tolerance, startStable, status;
    struct ssOut sOut;
    struct quaidsTVPMultiStartOut dOut;

    scaleRatio = _quaidsTVPDiagResolveScaleRatio(
        scaleRatio, "quaidsTVPMultiStartDiagnostics");

    n = cols(prices);
    n1 = n - 1;
    nobs = rows(w);
    k_states = 2*n1 + n1*(n1+1)/2;
    if not _quaidsTVPDiagQValid(q0, k_states);
        errorlog "quaidsTVPMultiStartDiagnostics: q0 must be a finite, strictly positive k_states x 1 vector.";
        end;
    endif;

    multipliers = 0.1|1|10;
    qStarts = q0*multipliers';
    i = 1;
    do while i <= 3;
        if not _quaidsTVPDiagQValid(qStarts[., i], k_states);
            errorlog "quaidsTVPMultiStartDiagnostics: every derived 0.1x/1x/10x q0 start must remain finite and strictly positive.";
            end;
        endif;
        i = i + 1;
    endo;

    { maxIters, maxTime } = _quaidsTVPResolveCaps(tvpCtl);
    pricesRel = prices[., 1:n1] - prices[., n];
    lx = _quaidsTVPStoneIndex(w, prices, totexp, n);
    Zarr = _quaidsTVPBuildZ(pricesRel, lx, n1);

    retcodes = miss(zeros(3, 1), 0);
    fitOk = zeros(3, 1);
    qValid = zeros(3, 1);
    llValid = zeros(3, 1);
    scaleCaution = miss(zeros(3, 1), 0);
    loglikelihoods = miss(zeros(3, 1), 0);
    qfits = miss(zeros(k_states, 3), 0);
    nScaleCollapse = miss(zeros(3, 1), 0);

    i = 1;
    do while i <= 3;
        sOut = _quaidsTVPMLEFit(Zarr, H, w[., 1:n1], qStarts[., i], n1,
            maxIters, maxTime);
        retcodes[i] = sOut.mleResults.retcode;
        fitOk[i] = retcodes[i] == 0;
        qFitRaw = sOut.final_params;
        { qIsValid, qFit } = _quaidsTVPDiagNormalizeQ(qFitRaw, k_states);
        qValid[i] = qIsValid;
        qfits[., i] = qFit;

        if qValid[i];
            { armScaleCaution, armScaleCollapse } =
                _quaidsTVPDiagScaleCaution(qFit, qStarts[., i], scaleRatio);
            scaleCaution[i] = armScaleCaution;
            nScaleCollapse[i] = armScaleCollapse;
            llRaw = _quaidsTVPDiagTotalLL(Zarr, qFit, H, w[., 1:n1], n1);
            { llIsValid, ll } = _quaidsTVPDiagNormalizeLL(llRaw);
            llValid[i] = llIsValid;
            loglikelihoods[i] = ll;
        endif;
        i = i + 1;
    endo;

    nValidQ = sumc(qValid);
    anyCaution = 0;
    i = 1;
    do while i <= 3;
        if qValid[i];
            if scaleCaution[i] == 1;
                anyCaution = 1;
            endif;
        endif;
        i = i + 1;
    endo;
    if not anyCaution and nValidQ /= 3;
        anyCaution = miss(0, 0);
    endif;

    tolerance = 1e-6*nobs;
    bestStartIndex = miss(0, 0);
    bestLL = miss(0, 0);
    maxLLGap = miss(0, 0);
    startStable = 0;
    if sumc(qValid) == 3 and sumc(llValid) == 3;
        { startStable, bestStartIndex, bestLL, maxLLGap, tolerance } =
            _quaidsTVPDiagCompareLL(retcodes, loglikelihoods, nobs);
    endif;

    status = _quaidsTVPDiagMultiStatus(
        retcodes, qValid, llValid, anyCaution, maxLLGap, tolerance);

    dOut.status = status;
    dOut.statusLabel = _quaidsTVPDiagStatusLabel(
        status, "START-STABLE-OBSERVED");
    dOut.scaleRatio = scaleRatio;
    dOut.multipliers = multipliers;
    dOut.retcodes = retcodes;
    dOut.fitOk = fitOk;
    dOut.qValid = qValid;
    dOut.llValid = llValid;
    dOut.scaleCaution = scaleCaution;
    dOut.anyScaleCaution = anyCaution;
    dOut.loglikelihoods = loglikelihoods;
    dOut.qfits = qfits;
    dOut.nScaleCollapse = nScaleCollapse;
    dOut.bestStartIndex = bestStartIndex;
    if scalmiss(bestStartIndex);
        dOut.bestMultiplier = miss(0, 0);
    else;
        dOut.bestMultiplier = multipliers[bestStartIndex];
    endif;
    dOut.bestLL = bestLL;
    dOut.maxLLGap = maxLLGap;
    dOut.tolerance = tolerance;
    dOut.startStable = startStable;

    retp(dOut);
endp;
