#ifndef QUAIDS_SDF_INCLUDED
#define QUAIDS_SDF_INCLUDED

struct quaidsControl {
    matrix maxiter;
    matrix alpha0;
    string othnam;
    matrix linear;
    matrix homogenous;
    matrix err;
    matrix b0;
    matrix relax;
};

/*
** quaidsOut -- struct returned by quaidsFit() (and, via its qOut.b/v/bS/vS
** fields, the raw legacy return values of quaids()). See the Milestone 1
** section of GOLD_STANDARD_TODO.md and the CLAUDE.md field-by-field notes
** for how each block maps back to the pre-Milestone-1 printed tables.
*/
struct quaidsOut {
    // Metadata
    string model;              // "LA-AIDS" | "AIDS" | "QUAIDS"
    matrix linear;
    matrix homogenous;
    matrix maxiter;
    matrix alpha0;
    matrix nobs;
    matrix n;                  // number of goods
    matrix nint;                // number of extra intercept-shifter variables
    matrix ninst;               // number of instruments
    matrix nu;                  // number of endogenous total-expenditure regressors
    matrix nendog;
    matrix n1;                  // n - homogenous
    matrix ng;
    matrix nz;
    matrix iterations;
    matrix converged;
    matrix finalErr;
    matrix iterHistory;         // Kx2: iteration number, convergence criterion
    // Name vectors below are legacy character matrices built with $+/ftocv,
    // not the newer native "string array" type -- must stay typed "matrix".
    matrix xnam;
    matrix wnam;
    matrix znam;
    matrix unam;
    matrix enam;
    matrix intcptFull;          // intcpt with the constant column prepended
    matrix u;                   // first-stage IV residuals

    // Instrumental-variables first-stage regression (log total expenditure on instruments)
    matrix ivB;
    matrix ivSE;
    matrix ivT;
    matrix ivPvt;
    matrix ivCor;
    matrix ivTv;
    matrix ivRsq;
    matrix ivRbsq;
    matrix ivSse;
    matrix ivStdest;
    matrix ivFstat;
    matrix ivPvf;
    matrix ivDf;

    // Homogeneity-constrained (or unconstrained, if not homogenous) share-system estimates
    matrix homogB;
    matrix homogV;
    matrix homogSE;
    matrix homogT;
    matrix homogPvt;
    matrix homogCor;
    matrix homogTv;
    matrix homogRsq;
    matrix homogRbsq;
    matrix homogSse;
    matrix homogStdest;
    matrix homogFstat;
    matrix homogPvf;
    matrix homogDf;
    matrix homogCrit;

    // Overidentification test (valid only when ninst > nu)
    matrix overidValid;
    matrix overidGamma;
    matrix overidSE;
    matrix overidT;
    matrix overidPvt;
    matrix overidFstat;
    matrix overidPvf;
    matrix overidDf;

    // Symmetry test given homogeneity (valid only when homogenous == 1)
    matrix symValid;
    matrix symStat;
    matrix symPval;
    matrix symDf;

    // Symmetry-constrained share-system estimates (valid only when homogenous == 1)
    matrix symcB;
    matrix symcV;
    matrix symcSE;
    matrix symcT;
    matrix symcPvt;
    matrix symcRsq;
    matrix symcRbsq;
    matrix symcSse;
    matrix symcStdest;
    matrix symcCrit;

    // Final absolute-price-form estimates -- what quaids() returns as (b1, v1, b2, v2)
    matrix b;
    matrix v;
    matrix bS;
    matrix vS;

    // "Best available" estimates for downstream elasticities/Slutzky diagnostics:
    // symmetry-constrained if homogeneity was imposed, else the recovered
    // unconstrained fit.
    matrix bestB;
    matrix bestV;
};

/*
** quaidsElasOut -- struct returned by quaidsElasFit(): income and price
** elasticities (and their delta-method standard errors) at a single
** evaluation point. See the Milestone 5 section of GOLD_STANDARD_TODO.md.
*/
struct quaidsElasOut {
    matrix n;      // number of goods
    matrix wnam;   // legacy character matrix of good names (see quaidsOut.wnam)
    matrix er;     // n x 1, income elasticities
    matrix ep;     // n x n, uncompensated (Marshallian) price elasticities
    matrix epc;    // n x n, compensated (Hicksian) price elasticities
    matrix ser;    // n x 1, delta-method standard errors of er
    matrix sep;    // n x n, delta-method standard errors of ep
    matrix sepc;   // n x n, delta-method standard errors of epc
};

/*
** quaidsSharesOut -- struct returned by quaidsSharesFit(): the model-
** implied predicted budget share vector (and its delta-method covariance/
** standard errors) at a single evaluation point. See the Milestone 16
** section of GOLD_STANDARD_TODO.md.
*/
struct quaidsSharesOut {
    matrix n;      // number of goods
    matrix wnam;   // legacy character matrix of good names (see quaidsOut.wnam)
    matrix w;      // n x 1, predicted budget shares at the point
    matrix se;     // n x 1, delta-method standard errors of w
    matrix v;      // n x n, full delta-method covariance of w
};

/*
** quaidsCurvOut -- struct returned by quaidsCurvatureFit(): a homogeneity+
** symmetry-constrained AIDS/LA-AIDS fit re-estimated under an additional
** local curvature (Slutzky negative semidefiniteness) restriction at the
** sample mean, via the Diewert-Wales Cholesky reparametrization. See the
** Milestone 10 section of GOLD_STANDARD_TODO.md.
*/
struct quaidsCurvOut {
    matrix n;         // number of goods
    matrix n1;        // n - 1 (size of the reparametrized Cholesky factor)
    matrix nint;      // number of extra intercept-shifter variables
    matrix wnam;      // legacy character matrix of good names
    matrix cholA;     // n1 x n1, the estimated lower-triangular Cholesky factor
    matrix b;         // curvature-constrained coefficient matrix: intercept
                      //   | gamma | beta, plus a trailing lambda row for
                      //   QUAIDS fits (Milestone 13). No u row (unlike
                      //   qOut.bestB) -- the u-coefficient is estimated
                      //   internally (profiled out alongside beta/lambda
                      //   given each candidate A) but not reported here
    matrix v;         // covariance of vec(b), via the delta method
    matrix se;        // standard errors, same shape as b
    matrix gama;      // n x n curvature-constrained price-effect matrix
                      //   (also b's gamma block, kept separately for convenience)
    matrix converged; // 1 if the outer iteration converged, 0 otherwise
    matrix iterations;
    matrix finalErr;
    matrix intcptPt;  // reference point used to impose curvature (sample means)
    matrix pricesPt;
    matrix totexpPt;
    matrix eigenvalues;      // n x 1, Slutzky-matrix eigenvalues at the
                              //   reference point (<=0 to numerical
                              //   precision, by construction)
};

/*
** quaidsCurvBootOut -- struct returned by quaidsCurvatureBootstrapFit(): an
** i.i.d. row (pairs) bootstrap standard error for a quaidsCurvatureFit()
** coefficient vector, reported alongside (not replacing) the existing
** delta-method SE. See the Milestone 15 section of GOLD_STANDARD_TODO.md.
*/
struct quaidsCurvBootOut {
    matrix n;           // number of goods
    matrix n1;          // n - 1
    matrix nint;        // number of extra intercept-shifter variables
    matrix wnam;        // legacy character matrix of good names
    matrix b;           // point estimate: original unresampled cOut.b
    matrix seDelta;     // original unresampled cOut.se (delta method), for comparison
    matrix seBoot;      // bootstrap standard error, same shape as b
    matrix bBoot;       // nCompleted x (rows(b)*cols(b)), raw vec(b) draws
    matrix nRequested;  // B as passed in
    matrix nCompleted;  // replications actually used in seBoot
    matrix nFailed;     // replications attempted but excluded (non-convergence or a trapped error)
    matrix nAttempts;   // total resamples drawn (>= nCompleted+nFailed only if the attempt cap was hit)
    matrix seed;        // seed as passed in, echoed for reproducibility records
};

/*
** quaidsWelfareOut -- struct returned by quaidsWelfareFit(): exact
** compensating variation (CV) and equivalent variation (EV) for a price
** change from a base point to a new point, holding nominal expenditure
** fixed. See the Milestone 11 section of GOLD_STANDARD_TODO.md.
*/
struct quaidsWelfareOut {
    matrix cv;    // compensating variation (money, not log-money)
    matrix ev;    // equivalent variation (money, not log-money)
    matrix seCV;  // delta-method standard error of cv
    matrix seEV;  // delta-method standard error of ev
    matrix u0;    // ln V at the base point (p0, x0)
    matrix u1;    // ln V at (p1, x0) -- new prices, unchanged nominal expenditure
    matrix pricesPt0;
    matrix pricesPt1;
    matrix totexpPt0;
};

/*
** quaidsZeroOut -- struct returned by quaidsZeroFit(): AIDS/QUAIDS
** coefficients corrected for zero budget shares via the Shonkwiler-Yen
** (1999) two-step procedure -- an unconstrained (no homogeneity/symmetry
** imposition in this first pass) fit, with a per-good first-stage probit
** correcting for the probability of a corner (zero-share) solution. See
** the Milestone 19 section of GOLD_STANDARD_TODO.md.
*/
struct quaidsZeroOut {
    matrix n;          // number of goods (every good is directly estimated -- no
                       //   adding-up recovery in this unconstrained-only pass)
    matrix nint;       // number of extra intercept-shifter variables
    matrix nobs;
    matrix xnam;       // legacy character matrix of intercept-block names
    matrix wnam;       // legacy character matrix of good names
    matrix unam;       // legacy character matrix of IV-residual names
    matrix probitB;    // first-stage probit coefficients, one column per good
    matrix probitSE;   // first-stage probit standard errors, same shape as probitB
    matrix probitConverged;  // n x 1, 1 if that good's probit converged
    matrix shareZeroFrac;    // n x 1, observed fraction of zero shares per good
    matrix b;    // corrected coefficient matrix: intcpt | gamma | beta | [lambda]
                // | u | delta (trailing n x n block, diagonal by construction --
                //   see quaidsZeroFit()'s own header for why this block is n x n
                //   rows, not a single row like every other block)
    matrix v;    // covariance of vec(b) -- a simplified formula, see Remarks
    matrix se;   // standard errors, same shape as b
    matrix converged;  // 1 if the outer (translog price index) iteration converged
    matrix iterations;
    matrix finalErr;
};

#endif
