/*
** quaidscurvature.src
**
** Milestone 10: local curvature (Slutzky negative semidefiniteness)
** imposition via the Diewert-Wales (1987) Cholesky reparametrization,
** originally scoped to LA-AIDS/AIDS only. Milestone 13 extends it to
** QUAIDS (aCtl.linear=0) too -- see that milestone's section of
** GOLD_STANDARD_TODO.md for how the apparent extra entanglement (beta
** appears both in the plain beta'beta term AND, via b(p), inside the
** lambda-scaled cross-term) resolves using the same lag-then-solve trick
** quaidsFit()'s own main iteration loop already uses: beta/lambda never
** join optmt's searched parameter set, they're profiled out by OLS every
** outer round just like alpha/beta already were for AIDS. QUAIDS's outer
** loop is measurably less stable than AIDS's own two-block version
** though (found empirically, not assumed) -- aCtl.relax (Milestone 12)
** optionally under-relaxes it; default 1 is a no-op, byte-identical to
** every prior release.
**
** quaidsSlutzky() already computes, per observation, the matrix that must
** be negative semidefinite for the expenditure function to be concave:
**   wepc = -diag(w) + w*w' + gama + (beta'beta)*lx                 [AIDS]
**   wepc = -diag(w) + w*w' + gama
**        + (beta'beta + beta'mu + mu'beta + 2*mu'mu)*lx            [QUAIDS,
**                                              mu = lambda*lx/b(p)]
** Concavity of a flexible functional form cannot be imposed globally (a
** standard result, not a gap here) -- Diewert & Wales impose it locally,
** at one reference point. This uses the SAMPLE MEAN (intcptFull/prices/
** totexp means), matching quaidsElasFit()'s own "evaluate the model at a
** point" convention.
**
** Reparametrization: write gama's upper-left n1 x n1 block (n1 = n-1,
** the same reduced-rank convention used throughout this codebase for
** homogeneity/symmetry) as
**   gama[1:n1,1:n1] = -A*A' - K0
** where A is n1 x n1 lower triangular and K0 = wepc's non-gamma part
** evaluated at the reference point (for QUAIDS, this includes the
** lambda-cross-term above). This makes wepc = -A*A' at that point by
** construction, for ANY A -- negative semidefinite regardless of the
** data. The remaining row/column of gama is recovered via the same
** adding-up identity used everywhere else in this codebase.
**
** Estimation: nonlinear IV. Within each outer iteration (mirroring
** quaidsFit()'s own translog-price-index iteration -- K0 and the
** full-sample deflator(s) are held fixed within an iteration and updated
** between iterations), the free elements of A (vech(A), a small
** parameter vector) are found by minimizing the IV residual sum of
** squares via GAUSS's installed optmt package. For ANY candidate A, the
** remaining coefficients (intercept, beta, [lambda,] IV-residual
** coefficients) are exactly identified by ordinary least squares once
** gama(A) is substituted in as a fixed offset -- a "concentrated"/profiled
** nonlinear least squares problem, so optmt only ever searches over
** vech(A), never lambda and never the full parameter vector, for either
** model.
**
** Standard errors: a classical (homoskedastic) nonlinear least squares
** covariance for vech(A) -- 2*sigma2*Hessian(SSR)^-1, with the Hessian
** computed numerically -- propagated to the full reported coefficient
** vector via the same numerical-Jacobian delta-method pattern already
** used in quaidsElasFit(). This is a simplified, homoskedastic-across-
** equations approximation, not a full SUR/GMM sandwich; documented as
** such rather than overstated.
*/

/*
** _quaidsCurvGamma: given vech(A) and a fixed K0, returns the full n x n
** curvature-reparametrized gamma. Internal helper, no #ifDef guard needed
** (does not depend on quaidsControl). Unchanged by the QUAIDS extension --
** gamma's reparametrization never involves lambda.
*/
proc (1) = _quaidsCurvGamma(vechA, K0, n1);
    local A, C, ga;

    A = lowmat(xpnd(vechA));
    C = -A*A' - K0[1:n1, 1:n1];
    ga = C | (-sumc(C)');
    ga = ga ~ (-sumc(ga'));

    retp(ga);
endp;

/*
** _quaidsCurvGivenA: given vech(A) and fixed K0/deflator(s), the "given A"
** closed-form regression -- returns the full gamma and the exactly-
** identified (intercept, beta, [lambda,] u-coefficient) block, plus the
** SSR. lx2Fixed is a fixed (previous-outer-round) QUAIDS quadratic-term
** regressor, ignored when linear==1 (AIDS).
*/
proc (3) = _quaidsCurvGivenA(vechA, w, prices, intcptFull, lxFixed, lx2Fixed, u, K0, n1, n, linear);
    local ga, wtilde, i, X, m, gg, gw, bHat, sse, ssrTotal;

    ga = _quaidsCurvGamma(vechA, K0, n1);

    wtilde = w[., 1:n1];
    i = 1;
    do while i <= n1;
        wtilde[., i] = w[., i] - prices*ga[., i];
        i = i + 1;
    endo;

    if linear;
        X = intcptFull~lxFixed~u;
    else;
        X = intcptFull~lxFixed~lx2Fixed~u;
    endif;
    m = moment(X~wtilde, 0);
    gg = m[1:cols(X), 1:cols(X)];
    gw = m[1:cols(X), cols(X)+1:cols(X)+n1];
    bHat = solpd(gw, gg);
    sse = m[cols(X)+1:cols(X)+n1, cols(X)+1:cols(X)+n1] - bHat'gw;
    ssrTotal = sumc(diag(sse));

    retp(ga, bHat, ssrTotal);
endp;

proc (1) = _quaidsCurvObj(struct PV p, w, prices, intcptFull, lxFixed, lx2Fixed, u, K0, n1, n, linear, ind);
    local vechA, ga, bHat, ssr;
    struct modelResults mm;

    vechA = pvUnpack(p, 1);
    { ga, bHat, ssr } = _quaidsCurvGivenA(vechA, w, prices, intcptFull, lxFixed, lx2Fixed, u, K0, n1, n, linear);

    if ind[1];
        mm.function = ssr;
    endif;
    retp(mm);
endp;

/*
** _quaidsCurvRecoverFull: recovers the full n-good (alpha, beta, lambda)
** from the n1-good exactly-identified regression block, via the adding-up
** identity. lambda is returned as scalar 0 when linear==1 (AIDS) -- always
** 3 outputs regardless of model, since GAUSS procs have a fixed return
** count.
*/
proc (3) = _quaidsCurvRecoverFull(bHat, nint, linear);
    local alphaN1, betaN1, lambdaN1, alphaN, betaN, lambdaN, alpha, beta, lambda;

    /* Milestone 13 finding: a real, pre-existing bug latent since
       Milestone 10, exposed only now because the AIDS-only curvature
       fixture (tests/quaidsfixtures.src's _quaidsCurvatureSyntheticDGP)
       deliberately has no extra intercept shifters (nint=0), so this
       never ran with nint>0 before. Adding-up recovers the CONSTANT row
       (sums to 1 across goods -- budget shares sum to 1) differently from
       any extra intercept-SHIFTER rows (must sum to 0 across goods -- a
       demographic shifter reallocates shares, it doesn't change their
       total), exactly the distinction _quaidsSyntheticDGP() itself
       already draws (al~(1-sumc(al')) for the constant vs.
       al1~(-sumc(al1')) for a shifter). The original one-line
       `1 - sumc(alphaN1')` silently applied the constant-row formula to
       every row whenever nint>0. */
    alphaN1 = bHat[1:1+nint, .];
    betaN1 = bHat[2+nint, .];
    alphaN = -sumc(alphaN1');
    alphaN[1] = 1 - sumc(alphaN1[1, .]');
    betaN = -sumc(betaN1');
    alpha = alphaN1~alphaN;
    beta = betaN1~betaN;

    if linear;
        lambda = 0;
    else;
        lambdaN1 = bHat[3+nint, .];
        lambdaN = -sumc(lambdaN1');
        lambda = lambdaN1~lambdaN;
    endif;

    retp(alpha, beta, lambda);
endp;

/*******************************************************************************
**
** QUAIDSCURVATUREFIT
**
** Purpose:  re-estimates a homogeneity+symmetry-constrained AIDS or QUAIDS
**           fit under an additional local curvature (Slutzky negative
**           semidefiniteness) restriction at the sample mean, via the
**           Diewert-Wales Cholesky reparametrization. Silent, no printing
**           -- see printQuaidsCurvature().
**
** Format:     struct quaidsCurvOut cOut = quaidsCurvatureFit(qOut, w, prices, totexp, aCtl);
**
** Input:    qOut -- struct quaidsOut, from quaidsFit() called with
**                   aCtl.homogenous = 1 (either aCtl.linear = 1 [AIDS] or
**                   aCtl.linear = 0 [QUAIDS] -- both supported since
**                   Milestone 13). Errors clearly if not homogeneity+
**                   symmetry-constrained. Supplies starting values
**                   (qOut.bestB) and the first-stage IV residual (qOut.u).
**
**             w -- TxN budget shares (same sample used to fit qOut).
**
**             prices -- TxN log prices (absolute).
**
**             totexp -- Tx1 log total expenditure.
**
**             aCtl -- quaidsControl struct (aCtl.err controls the outer
**                   iteration's convergence tolerance, same as quaidsFit();
**                   aCtl.alpha0 fixes the translog intercept, same as
**                   elsewhere in this codebase).
**
** Output:  struct quaidsCurvOut -- see quaids.sdf. Curvature is imposed at
**           the sample mean (qOut.intcptFull/prices/totexp column means);
**           there is no caller-supplied evaluation point in this first
**           pass (matching Diewert & Wales' own standard practice of
**           evaluating at the sample mean, and avoiding an otherwise-
**           needed inner fixed-point solve for the model-implied share at
**           an arbitrary point).
**
*******************************************************************************/

proc (struct quaidsCurvOut) = quaidsCurvatureFit(struct quaidsOut qOut, w, prices, totexp, struct quaidsControl aCtl);

    local n, n1, nint, intcptFull, uResid, pricesPt, totexpPt, intcptPt,
        alpha, gama, beta, lambda, alphaOld, betaOld, lambdaOld, a_pPt, lxPt, b_pPt, lx2Pt, muPt, wPt, K0,
        Cstart, va, ve, vechA, bstack0, bstack, maxOuterIter, tol, iter, ok,
        alphaFull, a_pFull, lxFixed, b_pFull, lx2Fixed, bHat, ssr, err, linear,
        wepc, eigs, vechAHat, K, Kfree, jacG, e, be, ee, i, j, gPlus, gMinus,
        vechA_p, vechA_m, gaP, bP, alphaP, betaP, lambdaP, gaM, bM, alphaM,
        betaM, lambdaM, gVec, hessMat, hStep, ssrCenter, ssrPP, ssrPM, ssrMP,
        ssrMM, sigma2, covA, vAll, bAll, seAll, vechDim, dofX, oldtrp;
    struct quaidsCurvOut cOut;

    if qOut.homogenous /= 1;
        errorlog "quaidsCurvatureFit: qOut must come from a homogeneity+symmetry-constrained fit (aCtl.homogenous=1).";
        end;
    endif;

    linear = qOut.linear;

    n = qOut.n;
    n1 = n - 1;
    nint = qOut.nint;
    intcptFull = qOut.intcptFull;
    uResid = qOut.u;

    pricesPt = meanc(prices);
    totexpPt = meanc(totexp);
    intcptPt = meanc(intcptFull);

    alpha = qOut.bestB[1:1+nint, .];
    gama = qOut.bestB[1+nint+1:1+nint+n, .];
    beta = qOut.bestB[1+nint+n+1, .];
    if linear;
        lambda = zeros(1, n);
    else;
        lambda = qOut.bestB[1+nint+n+2, .];
    endif;

    /* Warm-start vech(A) from the starting fit's own gamma: project
       gama+K0 onto the nearest negative semidefinite matrix (clipping any
       positive eigenvalues to zero) and take its Cholesky-type square
       root. */
    a_pPt = aCtl.alpha0 + intcptPt'alpha*pricesPt + .5*pricesPt'gama*pricesPt;
    lxPt = totexpPt - a_pPt;
    if linear;
        wPt = alpha'intcptPt + gama'pricesPt + beta'lxPt;
        K0 = -diagrv(eye(n), wPt) + wPt*wPt' + beta'beta*lxPt;
    else;
        b_pPt = exp(pricesPt'beta');
        lx2Pt = (lxPt^2)/b_pPt;
        muPt = lambda*lxPt/b_pPt;
        wPt = alpha'intcptPt + gama'pricesPt + beta'lxPt + lambda'lx2Pt;
        K0 = -diagrv(eye(n), wPt) + wPt*wPt'
            + (beta'beta + beta'muPt + muPt'beta + 2*muPt'muPt)*lxPt;
    endif;
    Cstart = gama[1:n1, 1:n1] + K0[1:n1, 1:n1];
    Cstart = (Cstart + Cstart')/2;
    /* Milestone 15 finding: stress-testing this proc under bootstrap
       resampling surfaced a real gap -- on a sufficiently degenerate
       resample, eighv() can itself fail (not just return a numerically
       poor answer), and an unguarded call here crashed the entire calling
       job, not just this one fit. A pre-call finiteness check guards
       against a call-arity failure (error G0528 "More returns than
       targets") that trap 1 does not intercept (confirmed directly --
       trapping the call alone did not prevent this error); trap/scalmiss
       (Milestone 12's idiom, src/quaids.src:552-563) remains as a second
       layer for ordinary trappable numerical errors on an otherwise-finite
       input. On either kind of failure, fall back to a harmless identity
       decomposition (va=1s, ve=I) so the warm start is merely
       uninformative rather than fatal -- the outer iteration below still
       has to actually converge on its own merits regardless of how
       vechA was initialized. */
    if sumc(sumc(Cstart .eq Cstart)) == n1*n1 and maxc(maxc(abs(Cstart))) < 1e100;
        oldtrp = trapchk(1);
        trap 1,1;
        { va, ve } = eighv(-Cstart);
        trap oldtrp,1;
        if scalmiss(va) or scalmiss(ve);
            va = ones(n1, 1);
            ve = eye(n1);
        endif;
    else;
        va = ones(n1, 1);
        ve = eye(n1);
    endif;
    va = va .* (va .> 0);
    vechA = vech(lowmat(ve*diagrv(eye(n1), sqrt(va))));

    if linear;
        bstack0 = alpha|gama|beta;
    else;
        bstack0 = alpha|gama|beta|lambda;
    endif;
    /* Milestone 13: bumped from 50 -- AIDS still converges well under
       that (unchanged, ~10-20 iterations typically), but QUAIDS's
       necessarily-damped outer loop (see aCtl.relax above) can
       legitimately need on the order of 100-200 rounds to bring finalErr
       under aCtl.err, confirmed empirically, not guessed. */
    maxOuterIter = 300;
    tol = aCtl.err;
    iter = 1;
    ok = 1;
    lx2Fixed = 0;
    do while ok;

        alphaOld = alpha;
        betaOld = beta;
        lambdaOld = lambda;

        alphaFull = intcptFull*alpha;
        a_pFull = aCtl.alpha0 + sumc((prices.*alphaFull)') + .5*sumc(((prices*gama).*prices)');
        lxFixed = totexp - a_pFull;

        a_pPt = aCtl.alpha0 + intcptPt'alpha*pricesPt + .5*pricesPt'gama*pricesPt;
        lxPt = totexpPt - a_pPt;

        if linear;
            wPt = alpha'intcptPt + gama'pricesPt + beta'lxPt;
            K0 = -diagrv(eye(n), wPt) + wPt*wPt' + beta'beta*lxPt;
        else;
            /* beta lagged by one outer round to build b_p/lx2Fixed --
               exactly the trick quaidsFit()'s own main loop uses to build
               that round's lx2 regressor (quaids.src:279-280), applied
               here so this round's OLS solve (inside _quaidsCurvGivenA)
               can re-estimate a fresh beta/lambda given a now-fixed
               regressor column. */
            b_pFull = exp(prices*beta');
            lx2Fixed = (lxFixed^2)./b_pFull;
            b_pPt = exp(pricesPt'beta');
            lx2Pt = (lxPt^2)/b_pPt;
            muPt = lambda*lxPt/b_pPt;
            wPt = alpha'intcptPt + gama'pricesPt + beta'lxPt + lambda'lx2Pt;
            K0 = -diagrv(eye(n), wPt) + wPt*wPt'
                + (beta'beta + beta'muPt + muPt'beta + 2*muPt'muPt)*lxPt;
        endif;

        struct PV p0;
        p0 = pvCreate;
        p0 = pvPacki(p0, vechA, "vechA", 1);

        struct optmtControl c0;
        c0 = optmtControlCreate;
        c0.printIters = 0;

        struct optmtResults outR;
        outR = optmt(&_quaidsCurvObj, p0, w, prices, intcptFull, lxFixed, lx2Fixed, uResid, K0, n1, n, linear, c0);
        vechA = pvUnpack(outR.par, 1);

        { gama, bHat, ssr } = _quaidsCurvGivenA(vechA, w, prices, intcptFull, lxFixed, lx2Fixed, uResid, K0, n1, n, linear);
        { alpha, beta, lambda } = _quaidsCurvRecoverFull(bHat, nint, linear);

        /* Milestone 13: optional under-relaxation, reusing aCtl.relax
           (Milestone 12) -- default 1 means this is a no-op, byte-
           identical to every prior release (including AIDS, where the
           outer loop converges quickly and reliably without it). QUAIDS's
           extra beta->b_p->lx2 feedback (see the file header) makes this
           loop meaningfully less stable than AIDS's own two-block
           version; testing found undamped QUAIDS runs can diverge to
           NaN within a handful of iterations, while aCtl.relax<1 trades
           iteration count for stability -- gama itself is deliberately
           NOT damped (it must stay exactly -A*A'-K0 by construction; only
           the K0-building inputs alpha/beta/lambda are). */
        alpha = aCtl.relax*alpha + (1-aCtl.relax)*alphaOld;
        beta = aCtl.relax*beta + (1-aCtl.relax)*betaOld;
        if not linear;
            lambda = aCtl.relax*lambda + (1-aCtl.relax)*lambdaOld;
        endif;

        if linear;
            bstack = alpha|gama|beta;
        else;
            bstack = alpha|gama|beta|lambda;
        endif;
        err = maxc(maxc(abs((bstack-bstack0)./(bstack0 + (bstack0 .== 0)))));

        bstack0 = bstack;
        if err <= tol or iter >= maxOuterIter;
            ok = 0;
        endif;
        iter = iter + 1;
    endo;

    vechAHat = vechA;
    K = n1*(n1+1)/2;

    /* --- Standard errors: classical (homoskedastic) NLS covariance for
       vech(A) -- 2*sigma2*Hessian(SSR)^-1, Hessian computed numerically --
       propagated to the full reported coefficient vector via a numerical-
       Jacobian delta method (same finite-difference technique as
       quaidsElasFit()). K0/lxFixed/lx2Fixed are held at their converged
       values. */

    /* Numerical Hessians need larger steps than gradients (a second
       difference amplifies floating-point noise) -- calibrated
       empirically against this problem's SSR scale, not guessed. */
    hStep = (1e-2)*(abs(vechAHat) + 1e-2);

    hessMat = zeros(K, K);
    i = 1;
    do while i <= K;
        j = i;
        do while j <= K;
            vechA_p = vechAHat;
            vechA_p[i] = vechA_p[i] + hStep[i];
            if j == i;
                vechA_p[j] = vechA_p[j] + hStep[j];
                { gaP, bP, ssrPP } = _quaidsCurvGivenA(vechA_p, w, prices, intcptFull, lxFixed, lx2Fixed, uResid, K0, n1, n, linear);

                vechA_m = vechAHat;
                vechA_m[i] = vechA_m[i] - hStep[i];
                { gaM, bM, ssrMM } = _quaidsCurvGivenA(vechA_m, w, prices, intcptFull, lxFixed, lx2Fixed, uResid, K0, n1, n, linear);

                { gaP, bP, ssrCenter } = _quaidsCurvGivenA(vechAHat, w, prices, intcptFull, lxFixed, lx2Fixed, uResid, K0, n1, n, linear);
                hessMat[i, i] = (ssrPP - 2*ssrCenter + ssrMM)/(hStep[i]*hStep[i]);
            else;
                vechA_p[j] = vechA_p[j] + hStep[j];
                { gaP, bP, ssrPP } = _quaidsCurvGivenA(vechA_p, w, prices, intcptFull, lxFixed, lx2Fixed, uResid, K0, n1, n, linear);

                vechA_p = vechAHat;
                vechA_p[i] = vechA_p[i] + hStep[i];
                vechA_m = vechAHat;
                vechA_m[j] = vechA_m[j] - hStep[j];
                vechA_m[i] = vechA_m[i] + hStep[i];
                { gaP, bP, ssrPM } = _quaidsCurvGivenA(vechA_m, w, prices, intcptFull, lxFixed, lx2Fixed, uResid, K0, n1, n, linear);

                vechA_p = vechAHat;
                vechA_p[j] = vechA_p[j] + hStep[j];
                vechA_p[i] = vechA_p[i] - hStep[i];
                { gaP, bP, ssrMP } = _quaidsCurvGivenA(vechA_p, w, prices, intcptFull, lxFixed, lx2Fixed, uResid, K0, n1, n, linear);

                vechA_m = vechAHat;
                vechA_m[i] = vechA_m[i] - hStep[i];
                vechA_m[j] = vechA_m[j] - hStep[j];
                { gaM, bM, ssrMM } = _quaidsCurvGivenA(vechA_m, w, prices, intcptFull, lxFixed, lx2Fixed, uResid, K0, n1, n, linear);

                hessMat[i, j] = (ssrPP - ssrPM - ssrMP + ssrMM)/(4*hStep[i]*hStep[j]);
                hessMat[j, i] = hessMat[i, j];
            endif;
            j = j + 1;
        endo;
        i = i + 1;
    endo;

    if linear;
        dofX = cols(intcptFull~lxFixed~uResid);
    else;
        dofX = cols(intcptFull~lxFixed~lx2Fixed~uResid);
    endif;
    sigma2 = ssr/(rows(w)*n1 - K - dofX);
    hessMat = (hessMat + hessMat')/2;
    /* Milestone 15: same trap/scalmiss guard as the warm-start eighv()
       call above -- a numerical Hessian built from finite differences at
       a badly-behaved (e.g. bootstrap-resampled) point can be degenerate
       enough that eighv() itself fails outright, not just returns a poor
       answer. Fall back to a harmless identity decomposition; the
       resulting SE is then uninformative for this fit, which is
       acceptable (this is a genuinely pathological case, not the normal
       "boundary Cholesky entry" situation already documented above) and
       does not affect cOut.b/cOut.converged, which are already fixed by
       this point. */
    /* Milestone 15 finding: trap 1 does NOT catch every failure mode
       here -- on a sufficiently degenerate (e.g. NaN-filled) hessMat,
       eighv() can return FEWER return values than the call expects,
       which is a call-arity mismatch (error G0528 "More returns than
       targets"), not a trappable numerical error, and trap 1 does not
       intercept it. A pre-call finiteness check (the same "x .eq x"
       NaN-detection idiom used elsewhere in this milestone) avoids ever
       calling eighv() on bad input, rather than trying to catch a failure
       mode trap cannot catch. */
    /* Milestone 15 finding: the "x .eq x" NaN check alone is not enough --
       eighv() also hits the same non-trappable reduced-arity failure on a
       matrix containing plain Inf (confirmed directly: Inf .eq Inf is
       TRUE under IEEE 754, so a NaN-only check misses it), so both are
       checked explicitly here. */
    if sumc(sumc(hessMat .eq hessMat)) == K*K and maxc(maxc(abs(hessMat))) < 1e100;
        oldtrp = trapchk(1);
        trap 1,1;
        { va, ve } = eighv(hessMat);
        trap oldtrp,1;
        if scalmiss(va) or scalmiss(ve);
            va = ones(K, 1);
            ve = eye(K);
        endif;
    else;
        va = ones(K, 1);
        ve = eye(K);
    endif;
    /* Guard against a mildly non-positive-definite numerical Hessian
       (finite-difference noise near a flat direction) rather than let
       invpd hard-error -- clip tiny/negative eigenvalues up to a small
       positive floor before inverting. */
    va = va .* (va .> 1e-8) + 1e-8*(va .<= 1e-8);
    covA = 2*sigma2*(ve*diagrv(eye(K), 1./va)*ve');

    /* Delta method: Jacobian of the reported coefficient vector
       [alpha;gama;beta[;lambda]] with respect to vech(A), at the
       converged K0. */
    if linear;
        vAll = alpha|gama|beta;
    else;
        vAll = alpha|gama|beta|lambda;
    endif;
    vechDim = rows(vAll)*cols(vAll);
    jacG = zeros(vechDim, K);
    i = 1;
    do while i <= K;
        vechA_p = vechAHat;
        vechA_p[i] = vechA_p[i] + hStep[i];
        { gaP, bP, ssrPP } = _quaidsCurvGivenA(vechA_p, w, prices, intcptFull, lxFixed, lx2Fixed, uResid, K0, n1, n, linear);
        { alphaP, betaP, lambdaP } = _quaidsCurvRecoverFull(bP, nint, linear);

        vechA_m = vechAHat;
        vechA_m[i] = vechA_m[i] - hStep[i];
        { gaM, bM, ssrMM } = _quaidsCurvGivenA(vechA_m, w, prices, intcptFull, lxFixed, lx2Fixed, uResid, K0, n1, n, linear);
        { alphaM, betaM, lambdaM } = _quaidsCurvRecoverFull(bM, nint, linear);

        if linear;
            gPlus = vec(alphaP|gaP|betaP);
            gMinus = vec(alphaM|gaM|betaM);
        else;
            gPlus = vec(alphaP|gaP|betaP|lambdaP);
            gMinus = vec(alphaM|gaM|betaM|lambdaM);
        endif;
        jacG[., i] = (gPlus - gMinus)/(2*hStep[i]);
        i = i + 1;
    endo;

    vAll = jacG*covA*jacG';
    seAll = sqrt(diag(vAll));
    seAll = reshape(seAll, rows(bstack0), cols(alpha));

    if linear;
        wepc = -diagrv(eye(n), wPt) + wPt*wPt' + gama + (beta'beta)*lxPt;
    else;
        wepc = -diagrv(eye(n), wPt) + wPt*wPt' + gama
            + (beta'beta + beta'muPt + muPt'beta + 2*muPt'muPt)*lxPt;
    endif;
    eigs = eigh(wepc);

    cOut.n = n;
    cOut.n1 = n1;
    cOut.nint = nint;
    cOut.wnam = qOut.wnam;
    cOut.cholA = lowmat(xpnd(vechAHat));
    if linear;
        cOut.b = alpha|gama|beta;
    else;
        cOut.b = alpha|gama|beta|lambda;
    endif;
    cOut.v = vAll;
    cOut.se = seAll;
    cOut.gama = gama;
    cOut.converged = err <= tol;
    cOut.iterations = iter - 1;
    cOut.finalErr = err;
    cOut.intcptPt = intcptPt;
    cOut.pricesPt = pricesPt;
    cOut.totexpPt = totexpPt;
    cOut.eigenvalues = eigs;

    retp(cOut);
endp;


/*******************************************************************************
**
** PRINTQUAIDSCURVATURE
**
** Purpose:  prints the curvature-constrained coefficient table and the
**           Slutzky-matrix eigenvalues at the reference point captured in
**           a quaidsCurvOut structure.
**
** Format:     call printQuaidsCurvature(cOut);
**
*******************************************************************************/

proc 0 = printQuaidsCurvature(struct quaidsCurvOut cOut);

    local n, b, se, i;

    n = cOut.n;
    b = cOut.b;
    se = cOut.se;

    print;
    "CURVATURE-CONSTRAINED (DIEWERT-WALES) COEFFICIENT ESTIMATES";
    print "Converged:" cOut.converged "in" cOut.iterations "iterations, final relative change" cOut.finalErr;
    print;
    format /rd 10, 4;
    print$ ""~cOut.wnam';
    print "---------------------------------------------------------------"\
        "---------------";
    i = 1;
    do while i <= rows(b);
        print$ (0$+ftocv(i, 1, 0))~ftocv(b[i, .], 0, 4);
        print$ (0$+"")~(0$+"("$+ftocv(se[i, .], 0, 2)$+")");
        i = i + 1;
    endo;
    print;

    print "Slutzky matrix eigenvalues at the reference point (sample mean)"\
        " -- all should be <= 0 to numerical precision:";
    print cOut.eigenvalues';
    print;

endp;

/*
** _quaidsCurvBootOneRep: one bootstrap replication's worth of work -- refit
** quaidsFit() then quaidsCurvatureFit() on a resampled dataset, trapping
** both calls (Milestone 12's own trap/scalmiss idiom, src/quaids.src:552-
**563) since a bootstrap exercises far more random draws than any single
** prior test run, and quaidsCurvatureFit() has no internal guard of its own
** around its eighv()/Hessian-inversion calls. Empirically confirmed (not
** assumed) that trapping a struct-returning proc call degrades gracefully
** here: GAUSS does not abort the whole statement on a trapped error inside
** a called proc, it substitutes a scalar-missing value for the erroring
** expression and lets that proc's own execution continue to its retp(),
** so checking the specific fields this helper reads afterward is sufficient
** -- no separate struct-level scalmiss() call is needed (and would not work;
** scalmiss() takes a matrix, not a struct).
**
** Returns (status, bVec): status=1 and bVec=vec(cOutB.b)' on a genuine,
** fully-converged, finite replication; status=0 (bVec=0, unused by the
** caller) otherwise. A replication counts only if BOTH stages converge --
** a non-converged first-stage fit feeding the second stage is not a valid
** draw from the target sampling distribution, so there is no partial-
** inclusion rule. The explicit `b .eq b` finite-check catches ordinary
** floating-point NaN from a diverged fit (a different bit pattern than
** GAUSS's own "missing value" NaN, so scalmiss() alone would miss it) --
** any element failing to equal itself is NaN, trapped-missing or not.
*/
proc (2) = _quaidsCurvBootOneRep(wB, intcptB, pricesB, totexpB, instrB, struct quaidsControl aCtl);
    local oldtrp, status, bVec, hasNonFinite;
    struct quaidsOut qOutB;
    struct quaidsCurvOut cOutB;

    status = 0;
    bVec = 0;

    oldtrp = trapchk(1);
    trap 1,1;
    qOutB = quaidsFit(wB, intcptB, pricesB, totexpB, instrB, aCtl);
    trap oldtrp,1;

    if not scalmiss(qOutB.converged) and qOutB.converged == 1;
        oldtrp = trapchk(1);
        trap 1,1;
        cOutB = quaidsCurvatureFit(qOutB, wB, pricesB, totexpB, aCtl);
        trap oldtrp,1;

        if not scalmiss(cOutB.converged) and cOutB.converged == 1;
            hasNonFinite = minc(minc(cOutB.b .eq cOutB.b)) == 0;
            if not hasNonFinite;
                status = 1;
                bVec = vec(cOutB.b)';
            endif;
        endif;
    endif;

    retp(status, bVec);
endp;

/*******************************************************************************
**
** QUAIDSCURVATUREBOOTSTRAPFIT
**
** Purpose:  nonparametric i.i.d. row (pairs) bootstrap standard error for a
**           quaidsCurvatureFit() coefficient vector -- closes a documented
**           gap in the existing classical delta-method SE, which is known
**           to be unreliable whenever the estimated Cholesky factor lands
**           on the boundary of the negative-semidefinite cone (a frequent,
**           confirmed occurrence in both the AIDS and QUAIDS test
**           fixtures). Resamples rows of (w, intcpt, prices, totexp, instr)
**           with replacement, refits the WHOLE pipeline (quaidsFit() then
**           quaidsCurvatureFit()) on each resample -- not just the already-
**           fitted curvature struct -- so first-stage IV sampling
**           variability is captured too. Silent, no printing -- see
**           printQuaidsCurvatureBootstrap().
**
**           No default replication count: a single AIDS curvature fit
**           measures ~0.87s and a single QUAIDS curvature fit ~7.26s
**           (Milestone 13's own aCtl.relax finding), so at conventional
**           bootstrap sizes (200-1000) QUAIDS alone can take 24 minutes to
**           2 hours -- B must be chosen deliberately by the caller, not
**           defaulted to a "reasonable-sounding" number that quietly means
**           something very different for QUAIDS than for AIDS.
**
** Format:     struct quaidsCurvBootOut bootOut =
**                 quaidsCurvatureBootstrapFit(w, intcpt, prices, totexp, instr, aCtl, B, seed);
**
** Input:    w, intcpt, prices, totexp, instr -- same sample and shapes as
**                   quaidsFit(). Must satisfy aCtl.homogenous = 1 (checked
**                   up front, before any resampling).
**
**             aCtl -- quaidsControl struct, passed through unchanged to
**                   every quaidsFit()/quaidsCurvatureFit() call (including
**                   aCtl.relax for QUAIDS -- see quaidsCurvatureFit()'s own
**                   header for why that is often required for convergence).
**
**             B -- positive integer scalar, the number of bootstrap
**                   replications to complete. Required -- no default (see
**                   above).
**
**             seed -- scalar. If seed > 0, rndseed is set before drawing
**                   any resamples (reproducible runs); seed = 0 leaves
**                   GAUSS's current random state unchanged. Same convention
**                   as gauss-qardl's blockBootstrapQARDLDiag().
**
** Output:  struct quaidsCurvBootOut -- see quaids.sdf. Reports the delta-
**           method SE (seDelta) and the new bootstrap SE (seBoot) side by
**           side for direct comparison -- the existing SE is exposed, not
**           replaced. Up to 5*B total resamples are attempted before
**           giving up on reaching B completed replications (a resample
**           where either quaidsFit() or quaidsCurvatureFit() fails to
**           converge, traps an internal error, or returns a non-finite
**           coefficient is skipped and counted as failed, not included).
**
*******************************************************************************/

proc (struct quaidsCurvBootOut) = quaidsCurvatureBootstrapFit(w, intcpt, prices, totexp, instr, struct quaidsControl aCtl, B, seed);

    local tobs, n, n1, nint, wnam, bDim1, bDim2, bVecDim,
        completed, failed, attempts, maxAttempts, idx,
        wB, intcptB, pricesB, totexpB, instrB, status, bVec, bBoot, seBoot;
    struct quaidsOut qOut;
    struct quaidsCurvOut cOut;
    struct quaidsCurvBootOut bootOut;

    if aCtl.homogenous /= 1;
        errorlog "quaidsCurvatureBootstrapFit: aCtl.homogenous must be 1 (curvature imposition requires a homogeneity+symmetry-constrained fit).";
        end;
    endif;

    if rows(B)*cols(B) /= 1 or B < 1 or round(B) /= B;
        errorlog "quaidsCurvatureBootstrapFit: B must be a positive integer scalar.";
        end;
    endif;

    /* Base (unresampled) fit -- supplies the point estimate and the
       existing delta-method SE, and fails fast if the base fit itself
       doesn't converge, before any resampling is attempted. */
    qOut = quaidsFit(w, intcpt, prices, totexp, instr, aCtl);
    if qOut.converged /= 1;
        errorlog "quaidsCurvatureBootstrapFit: the base (unresampled) quaidsFit() did not converge.";
        end;
    endif;

    cOut = quaidsCurvatureFit(qOut, w, prices, totexp, aCtl);
    if cOut.converged /= 1;
        errorlog "quaidsCurvatureBootstrapFit: the base (unresampled) quaidsCurvatureFit() did not converge -- refusing to bootstrap around a non-converged point estimate.";
        end;
    endif;

    tobs = rows(w);
    n = qOut.n;
    n1 = n - 1;
    nint = qOut.nint;
    wnam = qOut.wnam;
    bDim1 = rows(cOut.b);
    bDim2 = cols(cOut.b);
    bVecDim = bDim1*bDim2;

    if seed > 0;
        rndseed seed;
    endif;

    bBoot = zeros(B, bVecDim);
    completed = 0;
    failed = 0;
    attempts = 0;
    maxAttempts = 5*B;

    do until completed >= B or attempts >= maxAttempts;
        attempts = attempts + 1;

        idx = ceil(rndu(tobs, 1) * tobs);
        wB      = w[idx, .];
        if intcpt == 0;
            intcptB = 0;
        else;
            intcptB = intcpt[idx, .];
        endif;
        pricesB = prices[idx, .];
        totexpB = totexp[idx, .];
        instrB  = instr[idx, .];

        { status, bVec } = _quaidsCurvBootOneRep(wB, intcptB, pricesB, totexpB, instrB, aCtl);

        if status == 1;
            completed = completed + 1;
            bBoot[completed, .] = bVec;
        else;
            failed = failed + 1;
        endif;
    endo;

    if completed < 1;
        errorlog "quaidsCurvatureBootstrapFit: no valid bootstrap replications completed.";
        end;
    endif;

    if completed < B;
        bBoot = bBoot[1:completed, .];
    endif;

    seBoot = reshape(stdc(bBoot), bDim1, bDim2);

    bootOut.n = n;
    bootOut.n1 = n1;
    bootOut.nint = nint;
    bootOut.wnam = wnam;
    bootOut.b = cOut.b;
    bootOut.seDelta = cOut.se;
    bootOut.seBoot = seBoot;
    bootOut.bBoot = bBoot;
    bootOut.nRequested = B;
    bootOut.nCompleted = completed;
    bootOut.nFailed = failed;
    bootOut.nAttempts = attempts;
    bootOut.seed = seed;

    retp(bootOut);
endp;

/*******************************************************************************
**
** PRINTQUAIDSCURVATUREBOOTSTRAP
**
** Purpose:  prints the curvature-constrained coefficient table with the
**           delta-method and bootstrap standard errors side by side, plus
**           the bootstrap run diagnostics (requested/completed/failed/
**           attempts/seed), from a quaidsCurvBootOut structure.
**
** Format:     call printQuaidsCurvatureBootstrap(bootOut);
**
*******************************************************************************/

proc 0 = printQuaidsCurvatureBootstrap(struct quaidsCurvBootOut bootOut);

    local i;

    print;
    "CURVATURE-CONSTRAINED COEFFICIENT ESTIMATES -- DELTA-METHOD vs. BOOTSTRAP STANDARD ERRORS";
    print "Bootstrap replications -- requested:" bootOut.nRequested "completed:" bootOut.nCompleted
        "failed:" bootOut.nFailed "attempts:" bootOut.nAttempts "seed:" bootOut.seed;
    print;
    format /rd 10, 4;
    print$ ""~bootOut.wnam';
    print "---------------------------------------------------------------"\
        "---------------";
    i = 1;
    do while i <= rows(bootOut.b);
        print$ (0$+ftocv(i, 1, 0))~ftocv(bootOut.b[i, .], 0, 4);
        print$ (0$+"delta")~(0$+"("$+ftocv(bootOut.seDelta[i, .], 0, 2)$+")");
        print$ (0$+"boot")~(0$+"("$+ftocv(bootOut.seBoot[i, .], 0, 2)$+")");
        i = i + 1;
    endo;
    print;

endp;
