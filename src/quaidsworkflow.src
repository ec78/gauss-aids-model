/*
** quaidsworkflow.src
**
** Milestone 21 seed: a first high-level applied workflow bundle. This proc
** does not introduce new econometrics; it composes existing, individually
** tested public procs into the default post-estimation path: run the silent
** preflight diagnostics, fit the demand system, evaluate predicted shares
** and elasticities at the sample mean, and compute robust/cluster-robust
** standard errors when the base fit converged. A second proc,
** quaidsWorkflowScenarioFit(), adds exact welfare measures for one explicit
** price-change scenario without changing quaidsWorkflowFit()'s signature.
*/

/*******************************************************************************
**
** QUAIDSWORKFLOWFIT
**
** Purpose:   preflight and fit a QUAIDS/AIDS system, then collect the
**            standard mean-point post-estimation products in one silent
**            struct-returning call.
**
** Format:    struct quaidsWorkflowOut wfOut =
**                quaidsWorkflowFit(w, intcpt, prices, totexp, instr, aCtl, clusterId=0, weight=0);
**
** Milestone 26: gained an OPTIONAL `weight` argument (a dynargs trailing
** argument originally; Milestone 28 converted it to a genuine `weight=0`
** keyword default), threaded into this proc's own quaidsPreflight()/
** quaidsFit()/quaidsRobustFit()/quaidsRobustCovariance() calls. Omit, or
** pass scalar `0`, for the unweighted workflow. Since Milestone 26,
** quaidsSurveyWorkflowFit() forwards its required `weight` into this
** same estimator-level argument and also uses it for the weighted
** evaluation point. See wfOut.weighted/weightSum/effN for estimator
** weighting and wfOut.surveyWeighted/surveyWeightSum for the survey
** workflow's weighted-evaluation-point metadata.
**
*******************************************************************************/

proc (struct quaidsWorkflowOut) = quaidsWorkflowFit(w, intcpt, prices, totexp, instr, struct quaidsControl aCtl, clusterId=0, weight=0);

    local n, nint, m_, intcptPt, pricesPt, totexpPt, statQ, pvalQ, dfQ,
        robustBFull, robustVFull, isWeighted, weightScalar;
    struct quaidsOut qOut;
    struct quaidsSharesOut sharesOut;
    struct quaidsSharesOut sharesRobustOut;
    struct quaidsElasOut elasOut;
    struct quaidsElasOut elasRobustOut;
    struct quaidsRobustOut robustOut;
    struct quaidsPreflightOut pOut;
    struct quaidsWorkflowOut wfOut;

    /* Milestone 26/28: optional keyword sampling-weight argument.
       Scalar 0 is the only unweighted sentinel; real sampling weights must
       be Tx1 vectors. isWeighted then decides whether the raw vector is
       forwarded to quaidsPreflight()/quaidsFit()/quaidsRobustFit(). */
    weightScalar = rows(weight)*cols(weight) == 1;
    if weightScalar;
        if scalmiss(weight) or weight /= 0;
            errorlog "quaidsWorkflowFit: weight must be scalar 0 or a Tx1 vector matching the number of observations.";
            end;
        endif;
    endif;
    isWeighted = not weightScalar;

    if isWeighted;
        pOut = quaidsPreflight(w, intcpt, prices, totexp, instr, aCtl, clusterId, weight);
        qOut = quaidsFit(w, intcpt, prices, totexp, instr, aCtl, weight);
    else;
        pOut = quaidsPreflight(w, intcpt, prices, totexp, instr, aCtl, clusterId, 0);
        qOut = quaidsFit(w, intcpt, prices, totexp, instr, aCtl);
    endif;

    n = qOut.n;
    nint = qOut.nint;
    m_ = meanc(qOut.intcptFull~prices~totexp);
    intcptPt = m_[1:1+nint];
    pricesPt = m_[1+nint+1:1+nint+n];
    totexpPt = m_[1+nint+n+1];

    wfOut.model = qOut.model;
    wfOut.linear = qOut.linear;
    wfOut.homogenous = qOut.homogenous;
    wfOut.n = qOut.n;
    wfOut.nobs = qOut.nobs;
    wfOut.nint = qOut.nint;
    wfOut.wnam = qOut.wnam;
    wfOut.weighted = qOut.weighted;
    wfOut.weightSum = qOut.weightSum;
    wfOut.effN = qOut.effN;
    wfOut.preflightWeightValid = pOut.weightValid;
    wfOut.preflightWeightSum = pOut.weightSum;
    wfOut.preflightEffN = pOut.effN;
    wfOut.preflightOk = pOut.ok;
    wfOut.preflightErrors = pOut.nErrors;
    wfOut.preflightWarnings = pOut.nWarnings;
    wfOut.preflightConvergenceRisk = pOut.convergenceRisk;
    wfOut.preflightShareAddOk = pOut.shareAddOk;
    wfOut.preflightMaxShareSumDev = pOut.maxShareSumDev;
    wfOut.preflightZeroShareCount = pOut.zeroShareCount;
    wfOut.preflightNegativeShareCount = pOut.negativeShareCount;
    wfOut.preflightDesignInvOk = pOut.designInvOk;
    wfOut.preflightIVValid = pOut.ivDiagnosticsValid;
    wfOut.preflightIVFstat = pOut.ivFstat;
    wfOut.preflightWeakIV = pOut.weakIV;
    wfOut.preflightClusterValid = pOut.clusterValid;
    wfOut.preflightNClusters = pOut.nClusters;
    wfOut.preflightMinClusterSize = pOut.minClusterSize;
    wfOut.preflightSingletonClusters = pOut.singletonClusters;
    wfOut.surveyWeighted = 0;
    wfOut.surveyWeightValid = miss(0, 0);
    wfOut.surveyWeightSum = miss(0, 0);
    wfOut.surveyWeightNPositive = miss(0, 0);
    wfOut.surveyWeightMin = miss(0, 0);
    wfOut.surveyWeightMax = miss(0, 0);
    wfOut.converged = qOut.converged;
    wfOut.iterations = qOut.iterations;
    wfOut.finalErr = qOut.finalErr;
    wfOut.symValid = qOut.symValid;
    if qOut.symValid == 1;
        wfOut.symStat = qOut.symStat;
        wfOut.symPval = qOut.symPval;
        wfOut.symDf = qOut.symDf;
        wfOut.symReject05 = qOut.symPval < .05;
    else;
        wfOut.symStat = miss(0, 0);
        wfOut.symPval = miss(0, 0);
        wfOut.symDf = miss(0, 0);
        wfOut.symReject05 = miss(0, 0);
    endif;
    wfOut.overidValid = qOut.overidValid;
    if qOut.overidValid == 1;
        wfOut.overidFstat = qOut.overidFstat;
        wfOut.overidPvf = qOut.overidPvf;
        wfOut.overidDf = qOut.overidDf;
        wfOut.overidReject05 = qOut.overidPvf .< .05;
    else;
        wfOut.overidFstat = miss(0, 0);
        wfOut.overidPvf = miss(0, 0);
        wfOut.overidDf = miss(0, 0);
        wfOut.overidReject05 = miss(0, 0);
    endif;
    wfOut.quadraticValid = 0;
    wfOut.quadraticStat = miss(0, 0);
    wfOut.quadraticPval = miss(0, 0);
    wfOut.quadraticDf = miss(0, 0);
    wfOut.quadraticReject05 = miss(0, 0);
    if qOut.linear == 0 and qOut.homogenous == 0;
        { statQ, pvalQ, dfQ } = quaidsQuadraticTest(qOut);
        wfOut.quadraticValid = 1;
        wfOut.quadraticStat = statQ;
        wfOut.quadraticPval = pvalQ;
        wfOut.quadraticDf = dfQ;
        wfOut.quadraticReject05 = pvalQ < .05;
    endif;
    wfOut.b = qOut.b;
    wfOut.v = qOut.v;
    wfOut.bS = qOut.bS;
    wfOut.vS = qOut.vS;
    wfOut.bestB = qOut.bestB;
    wfOut.bestV = qOut.bestV;
    wfOut.evalIntcpt = intcptPt;
    wfOut.evalPrices = pricesPt;
    wfOut.evalTotexp = totexpPt;

    wfOut.postValid = 0;
    wfOut.shares = miss(0, 0);
    wfOut.sharesSE = miss(0, 0);
    wfOut.sharesV = miss(0, 0);
    wfOut.incomeElas = miss(0, 0);
    wfOut.incomeElasSE = miss(0, 0);
    wfOut.priceElas = miss(0, 0);
    wfOut.priceElasSE = miss(0, 0);
    wfOut.compPriceElas = miss(0, 0);
    wfOut.compPriceElasSE = miss(0, 0);
    wfOut.robustValid = 0;
    wfOut.robustB = miss(0, 0);
    wfOut.robustV = miss(0, 0);
    wfOut.robustSE = miss(0, 0);
    wfOut.robustNClusters = miss(0, 0);
    wfOut.robustBestB = miss(0, 0);
    wfOut.robustBestV = miss(0, 0);
    wfOut.postRobustValid = 0;
    wfOut.sharesRobustSE = miss(0, 0);
    wfOut.sharesRobustV = miss(0, 0);
    wfOut.incomeElasRobustSE = miss(0, 0);
    wfOut.priceElasRobustSE = miss(0, 0);
    wfOut.compPriceElasRobustSE = miss(0, 0);
    wfOut.welfareValid = 0;
    wfOut.cv = miss(0, 0);
    wfOut.ev = miss(0, 0);
    wfOut.seCV = miss(0, 0);
    wfOut.seEV = miss(0, 0);
    wfOut.welfareRobustValid = 0;
    wfOut.seCVRobust = miss(0, 0);
    wfOut.seEVRobust = miss(0, 0);
    wfOut.u0 = miss(0, 0);
    wfOut.u1 = miss(0, 0);
    wfOut.scenarioIntcpt = miss(0, 0);
    wfOut.scenarioPrices0 = miss(0, 0);
    wfOut.scenarioPrices1 = miss(0, 0);
    wfOut.scenarioTotexp0 = miss(0, 0);

    if qOut.converged == 1;
        sharesOut = quaidsSharesFit(qOut.bestB, qOut.bestV, intcptPt, pricesPt, totexpPt, aCtl);
        elasOut = quaidsElasFit(qOut.bestB, qOut.bestV, intcptPt, pricesPt, totexpPt, aCtl);
        if isWeighted;
            robustOut = quaidsRobustFit(qOut, w, prices, totexp, aCtl, clusterId, weight);
        else;
            robustOut = quaidsRobustFit(qOut, w, prices, totexp, aCtl, clusterId);
        endif;

        wfOut.postValid = 1;
        wfOut.shares = sharesOut.w;
        wfOut.sharesSE = sharesOut.se;
        wfOut.sharesV = sharesOut.v;
        wfOut.incomeElas = elasOut.er;
        wfOut.incomeElasSE = elasOut.ser;
        wfOut.priceElas = elasOut.ep;
        wfOut.priceElasSE = elasOut.sep;
        wfOut.compPriceElas = elasOut.epc;
        wfOut.compPriceElasSE = elasOut.sepc;
        wfOut.robustValid = 1;
        wfOut.robustB = robustOut.b;
        wfOut.robustV = robustOut.v;
        wfOut.robustSE = robustOut.se;
        wfOut.robustNClusters = robustOut.nClusters;

        { robustBFull, robustVFull } = quaidsRobustCovariance(qOut, robustOut, aCtl);
        sharesRobustOut = quaidsSharesFit(robustBFull, robustVFull, intcptPt, pricesPt, totexpPt, aCtl);
        elasRobustOut = quaidsElasFit(robustBFull, robustVFull, intcptPt, pricesPt, totexpPt, aCtl);

        wfOut.postRobustValid = 1;
        wfOut.robustBestB = robustBFull;
        wfOut.robustBestV = robustVFull;
        wfOut.sharesRobustSE = sharesRobustOut.se;
        wfOut.sharesRobustV = sharesRobustOut.v;
        wfOut.incomeElasRobustSE = elasRobustOut.ser;
        wfOut.priceElasRobustSE = elasRobustOut.sep;
        wfOut.compPriceElasRobustSE = elasRobustOut.sepc;
    endif;

    retp(wfOut);
endp;


/*******************************************************************************
**
** QUAIDSWORKFLOWSCENARIOFIT
**
** Purpose:   fit the default workflow and add exact CV/EV welfare measures
**            for one explicit price-change scenario.
**
** Format:    struct quaidsWorkflowOut wfOut =
**                quaidsWorkflowScenarioFit(w, intcpt, prices, totexp, instr,
**                    aCtl, intcptPt, pricesPt0, pricesPt1, totexpPt0, clusterId=0, weight=0);
**
** Milestone 26: gained the same OPTIONAL `weight` argument as
** quaidsWorkflowFit(), forwarded to it unchanged. Milestone 28 converted
** both `clusterId` and `weight` to genuine keyword defaults, moving
** `clusterId` after the required scenario inputs (`intcptPt`/
** `pricesPt0`/`pricesPt1`/`totexpPt0`) since GAUSS requires every
** required (non-defaulted) parameter to precede any keyword-defaulted one.
**
*******************************************************************************/

proc (struct quaidsWorkflowOut) = quaidsWorkflowScenarioFit(w, intcpt, prices, totexp, instr, struct quaidsControl aCtl, intcptPt, pricesPt0, pricesPt1, totexpPt0, clusterId=0, weight=0);

    struct quaidsWorkflowOut wfOut;
    struct quaidsWelfareOut wOut;
    struct quaidsWelfareOut wRobustOut;

    /* weight=0 hits quaidsWorkflowFit()'s own unweighted keyword-default
       path exactly as if omitted -- no isWeighted branch needed here. */
    wfOut = quaidsWorkflowFit(w, intcpt, prices, totexp, instr, aCtl, clusterId, weight);

    if wfOut.postValid == 1;
        wOut = quaidsWelfareFit(wfOut.bestB, wfOut.bestV, intcptPt, pricesPt0, pricesPt1, totexpPt0, aCtl);
        wfOut.welfareValid = 1;
        wfOut.cv = wOut.cv;
        wfOut.ev = wOut.ev;
        wfOut.seCV = wOut.seCV;
        wfOut.seEV = wOut.seEV;
        wfOut.u0 = wOut.u0;
        wfOut.u1 = wOut.u1;
        wfOut.scenarioIntcpt = intcptPt;
        wfOut.scenarioPrices0 = pricesPt0;
        wfOut.scenarioPrices1 = pricesPt1;
        wfOut.scenarioTotexp0 = totexpPt0;

        if wfOut.postRobustValid == 1;
            wRobustOut = quaidsWelfareFit(wfOut.robustBestB, wfOut.robustBestV, intcptPt, pricesPt0, pricesPt1, totexpPt0, aCtl);
            wfOut.welfareRobustValid = 1;
            wfOut.seCVRobust = wRobustOut.seCV;
            wfOut.seEVRobust = wRobustOut.seEV;
        endif;
    endif;

    retp(wfOut);
endp;
