/*
** quaidszerocorrect.src
**
** Milestone 19: AIDS/QUAIDS estimation corrected for zero budget shares
** via the Shonkwiler-Yen (1999) two-step procedure -- real survey data
** routinely has corner solutions (some households report zero
** expenditure on some goods), which quaidsFit() does not address.
**
** A self-contained sibling to quaidsFit(), not a modification of it --
** every one of quaidsFit()'s estimation stages (the GLS coefficient
** solve, the variance formula, the homogeneity/symmetry minimum-distance
** restriction, the overidentification test, the absolute-price recovery)
** is built on a Kronecker-product identity (e.g. `S[1:n-1,1:n-1].*.gg`,
** quaids.src:375) that only holds because every equation shares the same
** design matrix X. A literal, textbook Shonkwiler-Yen correction --
** rescaling every regressor by a per-equation, per-observation
** probability F_i -- breaks that shared-X assumption outright.
**
** The reformulation used here avoids that: Shonkwiler-Yen's equation
**   w_i = F_i*(alpha_i + sum_j gamma_ij*ln(p_j) + beta_i*lx [+ lambda_i*lx2]) + f_i*delta_i + e_i
** divides cleanly by F_i (a KNOWN, first-stage-fitted quantity, held
** fixed during the second stage):
**   w_i/F_i = alpha_i + sum_j gamma_ij*ln(p_j) + beta_i*lx [+ lambda_i*lx2] + (f_i/F_i)*delta_i + e_i/F_i
** turning the problematic *regressor* rescaling into a dependent-
** variable transform (wTilde_i = w_i/F_i, computed once) plus one new
** shared regressor column per equation (h_i = f_i/F_i) -- structurally
** the same kind of addition as the `u` (IV-residual) columns quaidsFit()
** already appends to its own shared X. The shared-X trick survives
** intact, and the whole quaidsFit()-style translog-price-index iteration
** carries over unchanged, just fed wTilde/h instead of w.
**
** What this reformulation does NOT remove: appending n hazard columns
** (h_1..h_n) to a shared X means the one-shot GLS solve estimates a full
** n x n cross-equation "delta" block (every equation's response to
** EVERY good's hazard term), when Shonkwiler-Yen only wants the diagonal
** (good i's own hazard term in good i's own equation). This needs a
** minimum-distance restriction forcing the off-diagonal entries to
** exactly zero -- mechanically the same design()/selection-matrix idiom
** quaidsFit()'s own symmetry-restriction stage already uses
** (quaids.src:526-614), just a different restriction pattern (diagonal,
** not gamma_ij=gamma_ji).
**
** Milestone 30 adds homogeneity/symmetry imposition on top of the
** Shonkwiler-Yen correction (aCtl.homogenous=1), via the SAME kind of
** n1=n-aCtl.homogenous reparametrization quaidsFit() itself uses for
** homogeneity (only n1 price/gamma ROWS are used as regressors -- every
** one of the n EQUATION columns is still directly, independently
** estimated throughout, unlike quaidsFit(), whose singular share-
** residual covariance forces it to also drop and adding-up-recover an
** equation COLUMN; quaidsZeroFit()'s wTilde=w/F residuals are not
** singular this way, so no column recovery is needed here -- see
** _quaidsZeroSymDiagRestrict()'s own header). Symmetry and the existing
** diagonal-delta restriction are imposed SIMULTANEOUSLY in one combined
** minimum-distance GLS projection (_quaidsZeroSymDiagRestrict()) against
** the same simplified Vi=invpd(S).*.gg covariance
** _quaidsZeroDiagRestrict() already used -- this was the "combining two
** different minimum-distance restrictions in one pass" explicitly
** flagged as real, additional work when this file was first written.
**
** Milestone 30 also fixes a real, previously-undetected bug present
** since this file's original (Milestone 19) release: quaidsZeroFit()
** never converted its estimated gamma coefficients out of the internal
** "relative price" basis _quaidsIVFirstStage() applies (columns 1:n-1
** become p_i-p_n, column n stays absolute) into genuine absolute-price
** form -- unlike quaidsFit(), which has a dedicated final recovery block
** for exactly this (quaids.src's "RECOVERS ABSOLUTE PRICE EFFECTS FROM
** RELATIVE"). This meant zOut.b's gamma columns 1..n-1 previously held
** gamma_ij-gamma_in (a coefficient on the relative-price regressor), not
** genuine gamma_ij, in the shipped unconstrained mode. Fixed in BOTH
** modes via the new _quaidsZeroRecoverAbsolute() helper, mirroring
** quaidsFit()'s own two-branch recovery block. This changes zOut.b's
** VALUES (not its shape) for existing unconstrained callers -- see
** CHANGELOG.md.
**
** Remaining scope, still deliberately limited (not silently absent):
** - Standard errors are a SIMPLIFIED formula: `V(vec(b)) = S .*. inv(gg)`
**   (the classic SUR-with-shared-regressors covariance), which does NOT
**   account for (a) the nonlinear translog-price-index feedback the way
**   quaidsFit()'s own Jacobian-corrected variance does (quaids.src:340-
**   363), or (b) first-stage probit/IV generated-regressor uncertainty.
**   Both are real, honestly-documented simplifications, matching this
**   project's established precedent for `quaidsCurvatureFit()`'s own
**   "simplified, not a full sandwich" delta-method SE. The new symmetry
**   test statistic (zOut.symStat) reuses this same simplified covariance
**   for consistency with the existing diagonal-delta machinery.
** - Adding-up does NOT hold exactly for the corrected coefficients --
**   this is a real, known property of Shonkwiler-Yen itself (each
**   equation is rescaled by its own good-specific F_i), not a bug. No
**   post-hoc renormalization is applied.
**
** Reuses _quaidsIVFirstStage() (quaidsiv.src) for its own IV first
** stage, and GAUSS's built-in glm() (c:\gauss26\src\glm.src, base
** runtime, no new package dependency) for the per-good probit stage.
*/

/*
** _quaidsZeroDiagRestrict: given the unconstrained coefficient matrix b
** (ng x n, trailing n rows = the hazard-coefficient block) and its
** simplified covariance components (S, gg), imposes the diagonal-delta
** restriction (off-diagonal hazard-coefficient entries = 0) via the same
** minimum-distance construction quaidsFit()'s own symmetry-restriction
** stage uses (quaids.src:526-614): b_s = V_s*Vi*vec(b), V_s = X*inv(X'Vi*X)*X'.
** Internal helper, no #ifDef guard needed.
*/
proc (3) = _quaidsZeroDiagRestrict(b, S, gg, ngOld, n);
    local ng, k, icReg, igDelta, ic, ig, i, Xdelta, j, Xsel, Si, Vi, oldtrp,
        XViXi, ok, bVec, Vrestricted, bRestricted;

    ng = ngOld + n;
    k = n*ngOld;

    icReg = seqa(1, 1, ngOld);
    igDelta = seqa(ngOld+1, 1, n);
    ic = vec(icReg + seqa(0, ng, n)');
    ig = vec(igDelta + seqa(0, ng, n)');
    i = ic|ig;
    i = sortind(i);

    Xdelta = zeros(n*n, n);
    j = 1;
    do while j <= n;
        Xdelta[(j-1)*n+j, j] = 1;
        j = j + 1;
    endo;

    Xsel = ( eye(k)        ~zeros(k, n) )|
           ( zeros(n*n, k) ~Xdelta       );
    Xsel = Xsel[i, .];

    ok = 1;
    oldtrp = trapchk(1);
    trap 1,1;
    Si = invpd(S);
    trap oldtrp,1;
    if scalmiss(Si);
        ok = 0;
    else;
        Vi = Si .*. gg;
        oldtrp = trapchk(1);
        trap 1,1;
        XViXi = invpd(Xsel'Vi*Xsel);
        trap oldtrp,1;
        if scalmiss(XViXi);
            ok = 0;
        endif;
    endif;

    if ok;
        bVec = vec(b);
        Vrestricted = Xsel*XViXi*Xsel';
        bRestricted = Vrestricted*Vi*bVec;
        bRestricted = reshape(bRestricted, n, ng)';
    else;
        /* Degrade gracefully (Milestone 12's established idiom) rather
           than crash the whole call -- fall back to a harmless diagonal
           extraction (zero out off-diagonal hazard terms directly,
           without the minimum-distance efficiency gain) and report an
           empty covariance; the caller's own convergence flag already
           reflects whether the main iteration succeeded. */
        bRestricted = b;
        j = 1;
        do while j <= n;
            bRestricted[ngOld+1:ngOld+n, j] = zeros(n, 1);
            bRestricted[ngOld+j, j] = b[ngOld+j, j];
            j = j + 1;
        endo;
        Vrestricted = zeros(n*ng, n*ng);
    endif;

    retp(bRestricted, Vrestricted, ok);
endp;

/*
** _quaidsZeroSymDiagRestrict: Milestone 30. Given the homogeneity-
** reparametrized coefficient matrix b (ng=ngOld+n rows x n columns,
** ngOld=1+nint+n1+nendog+nu, n1=n-1 -- caller must guarantee
** aCtl.homogenous=1) and its simplified covariance components (S, gg),
** imposes BOTH restrictions simultaneously in one minimum-distance GLS
** projection: gamma symmetry (see the derivation below for why this is
** NOT just "symmetrize the n1 x n1 submatrix gamma[1:n1,1:n1], leave
** column n free" -- an earlier draft of this proc did exactly that and
** was found, by direct empirical testing against a known-symmetric DGP,
** to leave the RECOVERED n x n absolute-price gamma measurably
** asymmetric), and hazard-block diagonality (identical to
** _quaidsZeroDiagRestrict()'s own Xdelta construction). Intercept and
** beta/[lambda]/u rows are left free via identity passthrough.
**
** The missing constraint, derived and verified before implementation:
** homogeneity's own row-recovery (_quaidsZeroRecoverAbsolute's
** R1Inner = eye(n1)|(-ones(1,n1))) gives the RECOVERED absolute-price
** gamma as gammaAbs[i,j] = gammaRel[i,j] for i<=n1, and
** gammaAbs[n,j] = -sum_{k=1}^{n1} gammaRel[k,j], for EVERY column j
** (including j=n). Full symmetry of gammaAbs (gammaAbs[i,n]==
** gammaAbs[n,i] for i=1..n1) therefore requires
** gammaRel[i,n] == -sum_{k=1}^{n1} gammaRel[k,i], NOT "gammaRel[.,n]
** free" -- i.e. column n's entries are themselves a DETERMINISTIC
** function of the SAME symmetric n1 x n1 sub-block (gammaSym) that
** drives columns 1..n1, via that sub-block's own row sums (using
** gammaSym's symmetry to rewrite the column-i sum as row i's own sum).
** Parametrizing via s=vech(gammaSym) (n1*(n1+1)/2 free parameters,
** matching the standard textbook count for homogeneity+symmetry
** jointly): vec(gammaSym)=R1*s (the usual vech->vec map), and
** gammaRel[.,n] = -(ones(1,n1).*.eye(n1))*vec(gammaSym) (the standard
** "row-sums as a linear map on vec()" identity, verified directly by a
** hand-worked 2x2 example before use) = -(ones(1,n1).*.eye(n1))*R1*s.
** Stacking both maps gives R1Combined (n1*(n1+1) rows x n1*(n1+1)/2
** columns), replacing the plain R1 an earlier draft used only for the
** sub-block. symDf is therefore n1*(n1+1)/2 (not n1*(n1-1)/2 -- the
** latter only counts the within-sub-block symmetry restrictions,
** missing these n1 additional column-n restrictions; verified by an
** independent degrees-of-freedom count: n1*n free gammaRel parameters
** before symmetry, n1*(n1+1)/2 remaining after, matching the standard
** AIDS homogeneity+symmetry free-parameter count n(n-1)/2). Internal
** helper, no #ifDef guard needed.
*/
proc (3) = _quaidsZeroSymDiagRestrict(b, S, gg, nint, ngOld, n1, n);
    local ng, nFree, nSym, icFree, ic, igSymSubBlock, igSymColN, igSym,
        igDelta, i, j, R1, R1ColN, R1Combined, Xdelta, k1, Xsel, Si, Vi,
        oldtrp, XViXi, ok, bVec, Vrestricted, bRestricted, Gsym, rowSum;

    ng = ngOld + n;

    /* Free rows: intercept + beta/[lambda]/u blocks only -- gamma's
       column-n entries are no longer free, see header. */
    nFree = ngOld - (1+nint+n1);
    icFree = seqa(1, 1, 1+nint) | seqa(1+nint+n1+1, 1, nFree);
    ic = vec(icFree + seqa(0, ng, n)');

    /* Gamma rows x columns 1..n1 (the symmetric sub-block): */
    igSymSubBlock = seqa(1+nint+1, 1, n1);
    igSymSubBlock = vec(igSymSubBlock + seqa(0, ng, n1)');
    /* Gamma rows x column n: derived from the SAME vech(gammaSym)
       parameters via the row-sum identity above, not free. */
    igSymColN = seqa(1+nint+1, 1, n1) + ng*(n-1);
    igSym = igSymSubBlock | igSymColN;

    /* Delta rows x all n columns: diagonal-restricted (identical idiom
       to _quaidsZeroDiagRestrict). */
    igDelta = seqa(ngOld+1, 1, n);
    igDelta = vec(igDelta + seqa(0, ng, n)');

    i = ic | igSym | igDelta;
    i = sortind(i);

    R1 = design(vec(xpnd(seqa(1, 1, n1*(n1+1)/2))));   /* n1^2 x nSym: vec(gammaSym)=R1*s */
    nSym = cols(R1);
    R1ColN = -(ones(1, n1).*.eye(n1))*R1;               /* n1 x nSym: gammaRel[.,n]=R1ColN*s */
    R1Combined = R1 | R1ColN;                            /* n1*(n1+1) x nSym */

    Xdelta = zeros(n*n, n);
    j = 1;
    do while j <= n;
        Xdelta[(j-1)*n+j, j] = 1;
        j = j + 1;
    endo;

    k1 = rows(ic);

    Xsel = ( eye(k1)                     ~zeros(k1, nSym)     ~zeros(k1, n) )|
           ( zeros(rows(R1Combined), k1) ~R1Combined          ~zeros(rows(R1Combined), n) )|
           ( zeros(n*n, k1)              ~zeros(n*n, nSym)    ~Xdelta        );
    Xsel = Xsel[i, .];

    ok = 1;
    oldtrp = trapchk(1);
    trap 1,1;
    Si = invpd(S);
    trap oldtrp,1;
    if scalmiss(Si);
        ok = 0;
    else;
        Vi = Si .*. gg;
        oldtrp = trapchk(1);
        trap 1,1;
        XViXi = invpd(Xsel'Vi*Xsel);
        trap oldtrp,1;
        if scalmiss(XViXi);
            ok = 0;
        endif;
    endif;

    if ok;
        bVec = vec(b);
        Vrestricted = Xsel*XViXi*Xsel';
        bRestricted = Vrestricted*Vi*bVec;
        bRestricted = reshape(bRestricted, n, ng)';
    else;
        /* Degrade gracefully (Milestone 12's established idiom): zero
           delta off-diagonal directly, symmetrize gamma[1:n1,1:n1] via
           simple averaging, and derive column n from that symmetrized
           sub-block's own row sums (not GLS-optimal, but well-defined
           and harmless) rather than crash the whole call. */
        bRestricted = b;
        j = 1;
        do while j <= n;
            bRestricted[ngOld+1:ngOld+n, j] = zeros(n, 1);
            bRestricted[ngOld+j, j] = b[ngOld+j, j];
            j = j + 1;
        endo;
        Gsym = b[1+nint+1:1+nint+n1, 1:n1];
        Gsym = (Gsym + Gsym')/2;
        bRestricted[1+nint+1:1+nint+n1, 1:n1] = Gsym;
        rowSum = -sumc(Gsym');
        bRestricted[1+nint+1:1+nint+n1, n] = rowSum;
        Vrestricted = zeros(n*ng, n*ng);
    endif;

    retp(bRestricted, Vrestricted, ok);
endp;

/*
** _quaidsZeroRecoverAbsolute: Milestone 30. Converts a coefficient
** matrix/covariance pair out of the internal "relative price" basis
** _quaidsIVFirstStage() applies (prices[.,1:n-1] become p_i-p_n, price
** column n stays absolute) into genuine absolute-price gamma -- the
** same job quaidsFit()'s own "RECOVERS ABSOLUTE PRICE EFFECTS FROM
** RELATIVE" block does (quaids.src ~665-725), which quaidsZeroFit() had
** no analog of before this milestone (a real, previously-undetected
** bug in the shipped Milestone 19 unconstrained mode -- see this file's
** header).
**
** Implemented via direct per-column matrix left-multiplication
** (bRecovered = SmallX*b, vRecovered = (eye(n).*.SmallX)*v*(eye(n).*.SmallX)')
** rather than quaidsFit()'s own vec/sortind selection-matrix idiom --
** the SAME relative->absolute transform applies identically and
** independently to every one of the n equation columns here (unlike
** quaidsFit(), which also has to recover an entire missing equation
** COLUMN via adding-up), so a single ngFinal x ng "SmallX" matrix
** applied once per column is both simpler and easier to verify directly
** than composing two vec-space passes. Two branches:
**   - aCtl.homogenous=0 (n1=n): relative->absolute conversion only, no
**     row-count change. gamma_abs_i = gamma_rel_i for i<n,
**     gamma_abs_n = gamma_rel_n - sum_{i<n}(gamma_rel_i) (the standard
**     rel_i=p_i-p_n identity), i.e. left-multiply gamma's own n x n
**     row-block by R1Inner = (eye(n-1)~0)|(-ones(1,n-1)~1).
**   - aCtl.homogenous=1 (n1=n-1): homogeneity's own row-recovery IS
**     already the absolute-price recovery in one step (no separate
**     relative->absolute pass needed on top) -- under homogeneity every
**     estimated gamma row is already purely relative (there is no
**     absolute-p_n row at all pre-recovery, since the iteration loop
**     pads gama with an implicit zero row for column n), so
**     gamma_abs_i = gamma_rel_i for i<=n1, gamma_abs_n =
**     -sum_{i<=n1}(gamma_rel_i), i.e. left-multiply by
**     R1Inner = eye(n1)|(-ones(1,n1)) (n x n1). Verified directly by
**     algebraic derivation (not assumed) before implementation.
** In both branches, intercept/endog/u/delta blocks pass through
** unchanged via identity (delta relocated to the end of the recovered
** row space in the homogeneous branch, since gamma's row count grew).
** The output row count, 1+nint+nendog+nu+2n, is independent of n1 --
** zOut.b's SHAPE is unaffected by this fix in either mode, only its
** VALUES change. Internal helper, no #ifDef guard needed.
*/
proc (2) = _quaidsZeroRecoverAbsolute(b, v, nint, ngOld, n1, n, nendog, nu, struct quaidsControl aCtl);
    local ng, ngFinal, R1Inner, SmallX, BigX, bRecovered, vRecovered;

    ng = ngOld + n;

    if not aCtl.homogenous;
        ngFinal = ng;
        R1Inner = ( eye(n-1) ~ zeros(n-1, 1) ) |
                  ( -ones(1, n-1) ~ 1 );
        SmallX = eye(ngFinal);
        SmallX[1+nint+1:1+nint+n, 1+nint+1:1+nint+n] = R1Inner;
    else;
        ngFinal = 1+nint+nendog+nu+2*n;
        R1Inner = eye(n1) | (-ones(1, n1));

        SmallX = zeros(ngFinal, ng);
        SmallX[1:1+nint, 1:1+nint] = eye(1+nint);
        SmallX[1+nint+1:1+nint+n, 1+nint+1:1+nint+n1] = R1Inner;
        SmallX[1+nint+n+1:1+nint+n+nendog+nu, 1+nint+n1+1:1+nint+n1+nendog+nu] = eye(nendog+nu);
        SmallX[ngFinal-n+1:ngFinal, ngOld+1:ngOld+n] = eye(n);
    endif;

    bRecovered = SmallX*b;
    BigX = eye(n).*.SmallX;
    vRecovered = BigX*v*BigX';

    retp(bRecovered, vRecovered);
endp;

/*******************************************************************************
**
** QUAIDSZEROFIT
**
** Purpose:  AIDS/QUAIDS estimation corrected for zero budget shares via
**           the Shonkwiler-Yen (1999) two-step procedure. Supports both
**           unconstrained estimation and, when aCtl.homogenous=1,
**           homogeneity/symmetry imposition on top of the correction.
**           Silent, no printing -- see printQuaidsZero().
**
** Format:     struct quaidsZeroOut zOut = quaidsZeroFit(w, intcpt, prices, totexp, instr, aCtl);
**
** Input:    w, intcpt, prices, totexp, instr -- same sample and shapes as
**                   quaidsFit().
**
**             aCtl -- quaidsControl struct, same fields as quaidsFit()
**                   uses (aCtl.linear, aCtl.maxiter, aCtl.err,
**                   aCtl.alpha0, aCtl.relax). The first-stage probit
**                   regresses each good's purchase indicator on
**                   intcpt/prices/totexp -- no separate regressor
**                   argument.
**
** Output:  struct quaidsZeroOut -- see quaids.sdf.
**
*******************************************************************************/

proc (struct quaidsZeroOut) = quaidsZeroFit(w, intcpt, prices, totexp, instr, struct quaidsControl aCtl);

    local nobs, n, n1, nint, xnam, wnam, unam, nu, nz, zzi, m1, enam,
        u, ivBtmp, ivSEtmp, ivTtmp, ivPvttmp, ivCortmp, ivTvtmp, ivDftmp,
        ivRsqtmp, ivRbsqtmp, ivSsetmp, ivStdesttmp, ivFstattmp, ivPvftmp,
        zProbit, F, fDens, wTilde, h, i, yProbit, probitB, probitSE,
        probitConverged, shareZeroFrac,
        oldtrp, stone, lx, endog, nendog, m, ngOld, ng, gg, gw,
        b, b0, ok, iter, err, alpha, gama, a_p, _beta, b_p, lx2, firstIter,
        iterHist, ww, sse, S, bDiag, VDiag, diagOk, bDiagAbs, vDiagAbs,
        bSymDiag, VSymDiag, symDiagOk, bSymAbs, vSymAbs, se, seS, b0Scalar,
        ggi, Vsym, viTest, u1, igSym, bVecFull, bSymDiagVecFull;
    struct quaidsZeroOut zOut;

    nobs = rows(w);
    n = cols(prices);
    n1 = n - aCtl.homogenous;

    if intcpt == 0;
        intcpt = ones(nobs, 1);
        nint = 0;
        xnam = 0$+"CONSTANT";
    else;
        nint = cols(intcpt);
        intcpt = ones(nobs, 1)~intcpt;
        xnam = 0$+"X"$+ftocv(seqa(1, 1, nint), __vpad*(floor(log(nint)+1), 0));
        xnam = (0$+"CONSTANT")|xnam;
    endif;

    wnam = 0$+"W"$+ftocv(seqa(1, 1, n), __vpad*(floor(log(n)+1), 0));

    /* --- IV first stage -- reuse the existing, cleanly-separable helper --- */
    /* Milestone 26 gave _quaidsIVFirstStage() a required weight argument;
       quaidsZeroFit() itself is not in scope for sampling-weighted
       estimation this milestone, so it passes ones(nobs,1) -- the exact
       no-op weight that reproduces its own pre-Milestone-26 behavior. */
    { prices, u, zzi, m1, nz, nu, enam,
        ivBtmp, ivSEtmp, ivTtmp, ivPvttmp, ivCortmp, ivTvtmp, ivDftmp,
        ivRsqtmp, ivRbsqtmp, ivSsetmp, ivStdesttmp, ivFstattmp, ivPvftmp }
        = _quaidsIVFirstStage(intcpt, prices, instr, totexp, n, ones(nobs, 1));

    unam = 0$+"U"$+ftocv(seqa(1, 1, nu), __vpad*(floor(log(nu)+1), 0));

    /* --- Probit stage: one probit per good, own purchase indicator on
       intcpt/prices/totexp (prices here are already the IV-stage's own
       relative-for-1:n-1/absolute-for-n convention -- irrelevant to the
       probit itself, which just needs a reasonable regressor set). --- */
    zProbit = intcpt~prices~totexp;

    F = zeros(nobs, n);
    fDens = zeros(nobs, n);
    probitB = zeros(cols(zProbit), n);
    probitSE = zeros(cols(zProbit), n);
    probitConverged = zeros(n, 1);
    shareZeroFrac = zeros(n, 1);

    struct glmControl gCtl;
    gCtl = glmControlCreate();
    gCtl.link = "probit";
    gCtl.constantFlag = -1;     /* zProbit already carries its own constant */
    gCtl.printFlag = "false";

    struct glmOut gOut;

    i = 1;
    do while i <= n;
        yProbit = w[., i] .> 0;
        shareZeroFrac[i] = 1 - meanc(yProbit);

        gOut = glm(yProbit, zProbit, "binomial", gCtl);

        probitB[., i] = gOut.coef.estimates;
        probitSE[., i] = gOut.coef.se;
        probitConverged[i] = gOut.iteration < gOut.maxIters;

        F[., i] = maxc((gOut.yhat)'|(1e-3*ones(1, nobs)));
        fDens[., i] = pdfn(zProbit*gOut.coef.estimates);

        i = i + 1;
    endo;

    wTilde = w ./ F;
    h = fDens ./ F;

    /**************************/
    /* STARTING VALUE (mirrors quaidsFit()'s own Stone-index block,
       quaids.src:216-248, targeting wTilde/h instead of w) */
    /***************************/

    stone = (prices[., 1:n-1] + prices[., n])~prices[., n];
    stone = stone*meanc(wTilde);
    lx = totexp - stone;
    if not aCtl.linear;
        endog = lx~lx^2;
    else;
        endog = lx;
    endif;
    nendog = cols(endog);

    m = moment(intcpt~prices[., 1:n1]~endog~u~h~wTilde, 0);
    ngOld = 1+nint+n1+nendog+nu;
    ng = ngOld + n;
    gg = m[1:ng, 1:ng];
    gw = m[1:ng, ng+1:ng+n];

    b0Scalar = rows(aCtl.b0)*cols(aCtl.b0) == 1;
    if b0Scalar and aCtl.b0 == 0;
        b = solpd(gw, gg);
    else;
        if rows(aCtl.b0) /= ng or cols(aCtl.b0) /= n;
            errorlog "quaidsZeroFit: aCtl.b0 must be scalar 0 or an ng x n reduced raw coefficient matrix matching zOut.bRaw.";
            end;
        endif;
        b = aCtl.b0;
    endif;

    /******************************/
    /* ITERATION (mirrors quaidsFit()'s own translog-price-index loop,
       quaids.src:259-321, aCtl.homogenous=0 branch) */
    /*****************************/

    ok = aCtl.maxiter > 1;
    iter = 1;
    firstIter = 1;
    do while ok;
        b0 = b;
        alpha = intcpt*b[1:1+nint, 1:n-1];
        if aCtl.homogenous;
            gama = b[1+nint+1:1+nint+n1, 1:n-1] | zeros(1, n-1);
        else;
            gama = b[1+nint+1:1+nint+n, 1:n-1];
        endif;

        a_p = aCtl.alpha0 + prices[., n]
            + sumc((prices[., 1:n-1].*alpha)')
            + .5*sumc(((prices*gama).*prices[., 1:n-1])');
        lx = totexp - a_p;
        if not aCtl.linear;
            _beta = b[1+nint+n1+1, 1:n-1];
            b_p = exp(prices[., 1:n-1]*_beta');
            lx2 = (lx^2)./b_p;
            endog = lx~lx2;
        else;
            endog = lx;
        endif;
        m[1+nint+n1+1:1+nint+n1+nendog, .]
            = endog'(intcpt~prices[., 1:n1]~endog~u~h~wTilde);
        m[., 1+nint+n1+1:1+nint+n1+nendog]
            = m[1+nint+n1+1:1+nint+n1+nendog, .]';
        gg = m[1:ng, 1:ng];
        gw = m[1:ng, ng+1:ng+n];
        b = solpd(gw, gg);

        b = aCtl.relax*b + (1-aCtl.relax)*b0;
        err = maxc(maxc(abs((b-b0)./(b0 + (b0 .== 0)))));
        if err <= aCtl.err or iter >= aCtl.maxiter;
            ok = 0;
        else;
            if firstIter;
                iterHist = iter~err;
                firstIter = 0;
            else;
                iterHist = iterHist | (iter~err);
            endif;
        endif;
        iter = iter + 1;
    endo;

    if aCtl.maxiter > 1;
        zOut.iterations = iter - 1;
        zOut.finalErr = err;
        zOut.converged = err <= aCtl.err;
    else;
        zOut.iterations = 0;
        zOut.finalErr = miss(0, 0);
        zOut.converged = 1;
    endif;

    /* --- Simplified variance: classic SUR-with-shared-regressors
       covariance (S .*. inv(gg)), NOT the nonlinear-Jacobian-corrected
       formula quaidsFit() itself uses -- see this file's header for why
       this is an honestly-documented simplification, not an oversight. */
    ww = m[ng+1:ng+n, ng+1:ng+n];
    sse = ww - b'gw;
    S = sse/nobs;

    /* Raw, pre-recovery coefficient matrix -- exposed so aCtl.b0 has a
       valid warm-start input to match against, mirroring quaidsFit()'s
       own qOut.homogB/aCtl.b0 pairing (its aCtl.b0 explicitly documents
       itself as matching qOut.homogB, not the final recovered qOut.b/
       qOut.bestB -- confirmed by reading quaids.src directly). Needed
       because zOut.b/zOut.bS are now (Milestone 30) in recovered,
       absolute-price form -- a different shape in homogeneous mode, and
       a different BASIS even in unconstrained mode -- so no longer a
       valid b0 input on their own. */
    zOut.bRaw = b;

    { bDiag, VDiag, diagOk } = _quaidsZeroDiagRestrict(b, S, gg, ngOld, n);
    { bDiagAbs, vDiagAbs } = _quaidsZeroRecoverAbsolute(bDiag, VDiag, nint, ngOld, n1, n, nendog, nu, aCtl);

    se = zeros(rows(bDiagAbs), n);
    if diagOk;
        se = reshape(sqrt(diag(vDiagAbs)), n, rows(bDiagAbs))';
    endif;

    zOut.symValid = aCtl.homogenous;
    if aCtl.homogenous;
        { bSymDiag, VSymDiag, symDiagOk } = _quaidsZeroSymDiagRestrict(b, S, gg, nint, ngOld, n1, n);
        { bSymAbs, vSymAbs } = _quaidsZeroRecoverAbsolute(bSymDiag, VSymDiag, nint, ngOld, n1, n, nendog, nu, aCtl);

        /* Symmetry test statistic: Vi=invpd(S).*.gg (used by both
           restrict procs above) is already the INVERSE covariance of
           vec(b) -- get the uninverted sub-covariance directly via the
           Kronecker identity inv(S.*.inv(gg)) = inv(S).*.gg, i.e.
           S.*.invpd(gg) is the uninverted covariance. */
        ggi = invpd(gg);
        igSym = seqa(1+nint+1, 1, n1);
        igSym = vec(igSym + seqa(0, ngOld+n, n1)');
        igSym = igSym | (seqa(1+nint+1, 1, n1) + (ngOld+n)*(n-1));
        Vsym = S .*. ggi;
        Vsym = Vsym[igSym, igSym];
        oldtrp = trapchk(1);
        trap 1,1;
        viTest = invpd(Vsym);
        trap oldtrp,1;
        if scalmiss(viTest);
            zOut.symStat = miss(0, 0);
            zOut.symPval = miss(0, 0);
        else;
            bVecFull = vec(b);
            bSymDiagVecFull = vec(bSymDiag);
            u1 = bVecFull[igSym] - bSymDiagVecFull[igSym];
            zOut.symStat = u1'*viTest*u1;
            zOut.symPval = cdfchic(zOut.symStat, n1*(n1+1)/2);
        endif;
        zOut.symDf = n1*(n1+1)/2;

        seS = zeros(rows(bSymAbs), n);
        if symDiagOk;
            seS = reshape(sqrt(diag(vSymAbs)), n, rows(bSymAbs))';
        endif;

        zOut.bS = bSymAbs;
        zOut.vS = vSymAbs;
        zOut.seS = seS;
        zOut.bestB = bSymAbs;
        zOut.bestV = vSymAbs;
    else;
        zOut.symStat = miss(0, 0);
        zOut.symPval = miss(0, 0);
        zOut.symDf = miss(0, 0);
        zOut.bS = 0;
        zOut.vS = 0;
        zOut.seS = 0;
        zOut.bestB = bDiagAbs;
        zOut.bestV = vDiagAbs;
    endif;

    zOut.n = n;
    zOut.n1 = n1;
    zOut.nint = nint;
    zOut.nobs = nobs;
    zOut.homogenous = aCtl.homogenous;
    zOut.xnam = xnam;
    zOut.wnam = wnam;
    zOut.unam = unam;
    zOut.probitB = probitB;
    zOut.probitSE = probitSE;
    zOut.probitConverged = probitConverged;
    zOut.shareZeroFrac = shareZeroFrac;
    zOut.b = bDiagAbs;
    zOut.v = vDiagAbs;
    zOut.se = se;

    retp(zOut);
endp;

/*******************************************************************************
**
** PRINTQUAIDSZERO
**
** Purpose:  prints the first-stage probit summary and the Shonkwiler-Yen-
**           corrected coefficient table captured in a quaidsZeroOut
**           structure.
**
** Format:     call printQuaidsZero(zOut);
**
*******************************************************************************/

proc 0 = printQuaidsZero(struct quaidsZeroOut zOut);

    local n, i, str;

    n = zOut.n;

    print;
    "ZERO-BUDGET-SHARE-CORRECTED (SHONKWILER-YEN) ESTIMATES";
    print "Converged:" zOut.converged "in" zOut.iterations "iterations, final relative change" zOut.finalErr;
    print;
    print "First-stage probit -- fraction of zero shares, and convergence, per good:";
    print$ ""~zOut.wnam';
    print$ (0$+"zero frac")~ftocv(zOut.shareZeroFrac', 0, 3);
    print$ (0$+"converged")~ftocv(zOut.probitConverged', 1, 0);
    print;

    format /rd 10, 4;
    print "Corrected coefficient table (intcpt | gamma | beta | [lambda] | u | delta):";
    print$ ""~zOut.wnam';
    print "---------------------------------------------------------------"\
        "---------------";
    i = 1;
    do while i <= rows(zOut.b);
        print$ (0$+ftocv(i, 1, 0))~ftocv(zOut.b[i, .], 0, 4);
        print$ (0$+"")~(0$+"("$+ftocv(zOut.se[i, .], 0, 2)$+")");
        i = i + 1;
    endo;
    print;

    if zOut.symValid;
        print "TEST OF SYMMETRY GIVEN HOMOGENEITY";
        print;
        str = ftos(zOut.symDf, "chi2(%*.*lf)", 1, 0);
        str = strsect(str, 1, 15) $+ ftos(zOut.symStat, "%*.*lf", 19, 8);
        print str;;
        print ftos(zOut.symPval, "                    p-value:  %*.*lf", 20, 3);
        print;

        print "HOMOGENEITY + SYMMETRY + DIAGONAL-DELTA CONSTRAINED COEFFICIENT TABLE";
        print$ ""~zOut.wnam';
        print "---------------------------------------------------------------"\
            "---------------";
        i = 1;
        do while i <= rows(zOut.bS);
            print$ (0$+ftocv(i, 1, 0))~ftocv(zOut.bS[i, .], 0, 4);
            print$ (0$+"")~(0$+"("$+ftocv(zOut.seS[i, .], 0, 2)$+")");
            i = i + 1;
        endo;
        print;
    endif;

endp;
